() {\n  function a() { return 2; }\n  function b() { 2; }\n  function c(x) { return x * 2; }\n  function d(x) { if (x > 0) return x; }\n  function e() { return null; }\n  function f() { return; }\n  const g = x => x + 1;\n  const h = x => { x + 1; };\n  return {a: a(), b: b(), c: c(3), dPositivo: d(4), dNegativo: d(-1), e: e(), f: f(), g: g(1), h: h(1)};\n}\n\nconst resultado = preverRetornos();\nconsole.log(JSON.stringify(Object.fromEntries(Object.entries(resultado).map(([chave, valor]) => [chave, valor === undefined ? \"undefined\" : valor]))));\n"}],"assets":[],"examples":[{"given":"a()","expected":"2; b() -> undefined; c(3) -> 6; d(0) -> undefined; e() -> null; f() -> undefined; g(2) -> 3; h(2) -> undefined"}],"checks":[{"fixture":{"given":"a()","expected":"2; b() -> undefined; c(3) -> 6; d(0) -> undefined; e() -> null; f() -> undefined; g(2) -> 3; h(2) -> undefined"},"scoring":"Compare resposta registrada antes de Run com sequência/valor previstos; confiança é diagnóstica."}],"constraints":[],"rubric":[],"learningMetadata":{"requires":["03.04"]},"edgeCases":["d(-1) -> undefined; d(2) -> 2; função que retorna null -> null, não undefined"],"review":{"prompt":"Ao depurar uma função chamada dentro de outra expressão, qual evidência mostra o valor que a expressão consumirá?","choices":["A última mensagem exibida no console, independentemente de onde foi produzida.","O valor retornado pela chamada, distinguindo-o de mensagens escritas como efeito colateral.","O valor da variável local com nome mais parecido com o da função."],"answer":1,"correctFeedback":"Correto: a expressão recebe o retorno da chamada; efeitos de console são observações separadas.","incorrectFeedback":"Uma mensagem exibida não é automaticamente o valor retornado. Siga o valor da chamada até o consumidor."},"stageBridge":"Uma função nomeia uma transformação com entradas e saída. Separe regras independentes em funções pequenas; a função de nível mais alto coordena seus resultados sem duplicar fórmulas.\r\n\r\nExemplo resolvido A: `custoPeso(kg)` recebe quilogramas e devolve um custo; `custoDistancia(km)` recebe quilômetros e devolve outro. Exemplo resolvido B: `frete(pedido)` chama as duas funções e soma os valores, mantendo as unidades claras. Exemplo com ajuda retirada: para um resumo de expediente, o aluno identifica entradas e saídas de `minutosTrabalhados` e `intervalo`, depois decide o que o resumo deve chamar. A ponte antecede `04.08`, que transfere composição para frete, e `04.09`, que combina regras derivadas em uma ficha.","stageBridgeTitle":"Funções pequenas que compõem uma regra","assessmentEnvironment":"javascript","autoTested":true,"preparation":{"guided":true,"stageTitle":"FUNÇÕES, RETORNO E ERROS","introduction":"Preencha para cada chamada o valor previsto e marque se alcança return.","explanation":"A chamada produz o valor indicado por return. Se o caminho termina sem executar return, JavaScript devolve undefined; null é um valor explícito.","conceptSteps":["A chamada produz o valor indicado por return.","Se o caminho termina sem executar return, JavaScript devolve undefined; null é um valor explícito.","Prever retornos permite compor funções, verificar resultados e separar cálculo de apresentação."],"vocabulary":[],"workedExample":{"steps":["Em function area(lado){return lado*lado}, area(4) calcula 4*4 e vale 16.","A forma `const area = lado => lado*lado` também devolve 16.","O valor pode compor outra expressão sem ser impresso."]},"notes":["Expressão solta em função com chaves não vira retorno. Arrow com corpo de expressão retorna implicitamente; com chaves, precisa de return.","Prever retornos permite compor funções, verificar resultados e separar cálculo de apresentação."],"docs":[],"materials":["Starter main.js com funções e chamadas.","Tabela de previsões em branco.","Console para conferir após Run."],"predictionGuide":"Preencha para cada chamada o valor previsto e marque se alcança return. Antes de executar, pedir dica ou abrir a solução