t","executionScope":"browser-behavior-suite"},{"id":"04.10.renomeacao-preserva-a-api-pu-003baa8c","sourceTestPath":"tests/04.10.test.js","testName":"renomeação preserva a API pública e o comportamento do pedido","inputExpression":"totalPedido(4, 3, 20)","matcher":"toBe","expectedExpression":"0","negated":false,"initialArrangementExpression":"expect(totalPedido(10, 2, 3)).toBe(17);\n  expect(totalPedido(0, 4, 0)).toBe(0);","assertionExpression":"expect(totalPedido(4, 3, 20)).toBe(0)","contractRule":"totalPedido(4, 3, 20) toBe 0","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(totalPedido(4, 3, 20)).toBe(0)","assertionOffset":361,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"04.10.renomeacao-preserva-a-api-pu-f981567a","sourceTestPath":"tests/04.10.test.js","testName":"renomeação preserva a API pública e o comportamento do pedido","inputExpression":"totalPedido(4, 3, 0)","matcher":"toBe","expectedExpression":"12","negated":false,"initialArrangementExpression":"expect(totalPedido(10, 2, 3)).toBe(17);\n  expect(totalPedido(0, 4, 0)).toBe(0);\n  expect(totalPedido(4, 3, 20)).toBe(0);","assertionExpression":"expect(totalPedido(4, 3, 0)).toBe(12)","contractRule":"totalPedido(4, 3, 0) toBe 12","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(totalPedido(4, 3, 0)).toBe(12)","assertionOffset":455,"assertionApi":"expect","executionScope":"browser-behavior-suite"}],"sourceTestPath":"tests/04.10.test.js","tests":"import {totalPedido} from './main.js';\n\ntest('renomeação preserva a API pública e o comportamento do pedido', () => {\n  /*@case 04.10.renomeacao-preserva-a-api-pu-bc46d0de*/expect(totalPedido(10, 2, 3)).toBe(17);\n  /*@case 04.10.renomeacao-preserva-a-api-pu-d8008f2e*/expect(totalPedido(0, 4, 0)).toBe(0);\n  /*@case 04.10.renomeacao-preserva-a-api-pu-003baa8c*/expect(totalPedido(4, 3, 20)).toBe(0);\n  /*@case 04.10.renomeacao-preserva-a-api-pu-f981567a*/expect(totalPedido(4, 3, 0)).toBe(12);\n});\n"},"reference":[{"path":"main.js","content":"export function totalPedido(precoUnitario, quantidade, desconto) {\n  const data = precoUnitario * quantidade;\n  const thing = d(data - desconto);\n  return thing;\n}\nfunction d(x) {\n  return Math.max(0, x);\n}\n"}]},{"item":{"id":"05.01","title":"Estado do array","stage":"05","kind":"PREDICT","contentVersion":2,"optional":false,"duration":"12 min","runtime":"Node.js 24 LTS · ECMAScript 2026 · módulos ES","compatibility":"Array e slice no baseline dependências fora do ECMAScript.","objective":"Desenhe uma caixa por identidade e anote o conteúdo de cada nome após cada linha.","prompt":"Rastreie o código linha por linha: desenhe quais nomes compartilham o mesmo array, preveja a saída e explique qual operação criou uma lista independente.","firstResponse":{"action":"Desenhe uma caixa por identidade e anote o conteúdo de cada nome após cada linha.","timing":"Antes do primeiro Run, dica ou solução."},"explanation":{"mental_model":"Atribuir uma variável cria outro nome para o mesmo array; uma cópia precisa de nova identidade.","worked_example":"Numa agenda, agendaB=agendaA faz ambos apontarem à mesma lista. Adicionar pausa por B aparece ao ler A. agendaC=agendaA.slice() cria lista independente; adicionar almoço a C não muda A.","common_trap":"Confundir alias com cópia; acompanhar identidade antes e depois de cada mutação.","why_it_matters":"Alias acidental muda estado compartilhado sem que o chamador espere."},"interaction":"Tabela de rastreamento e grafo de referências editável; oferecer descrição linear acessível ao desenho.","resources":["MDN Array: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array","MDN slice: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/slice"],"starterFiles":[{"path":"main.js","content":"export function observarReferencias() {\n  const a = [1, 2];\n  const b = a;\n  const c = a.slice();\n  a.push(3);\n  b.pop();\n  return {a, b, c, mesmaRaiz: a === b, copiaIndependente: a !== c};\n}\n\nconsole.log(JSON.stringify(observarReferencias()));\n"}],"assets":[],"examples":[{"given":"saída","expected":"[1,2],[1,2],[1,2]; antes do pop, a e b são [1,2,3]"}],"checks":[{"fixture":{"given":"saída","expected":"[1,2],[1,2],[1,2]; antes do pop, a e b são [1,2,3]"},"scoring":"Compare resposta registrada antes de Run com sequência/valor previstos; confiança é diagnóstica."}],"constraints":[],"rubric":[],"learningMetadata":{"requires":["04.01"]},"edgeCases":["c.push(4) depois -> c=[1,2,4], a/b continuam [1,2]"],"review":{"prompt":"Se um módulo não deve expor sua coleção mutável interna, que decisão de API reduz acoplamento?","choices":["Devolver o contêiner interno e presumir que todo chamador o tratará como imutável.","Guardar os dados numa variável global para que os consumidores compartilhem o mesmo estado.","Expor operações ou uma representação controlada, em vez de entregar diretamente o contêiner interno."],"answer":2,"correctFeedback":"Correto: uma API controlada protege a propriedade do estado e deixa explícitas as operações permitidas.","incorrectFeedback":"Uma referência mutável compartilhada permite que consumidores acoplem seus efeitos ao estado interno. Delimite a interface."},"stageBridge":"Strings e arrays entram com indexação, `slice`, `split`, `join` e operações de cópia/mutação. Aqui, callback significa função passada a outra operação para ser chamada por ela; o comparador passado a `sort` é o primeiro exemplo. `sort` altera o array; `toSorted` devolve outro array. Uma cópia rasa separa a coleção externa, mas não clona objetos internos. `map`, `filter` e pipelines de callbacks entram depois na etapa 07. Regex só é escolhida quando a regra textual permanece legível; formato estruturado complexo pede parser explícito. `RegExp.escape` só aparece sob contrato de runtime compatível.\r\n\r\nUnicode exige três contagens diferentes: unidades UTF-16 (`'😀'.length` é 2), pontos de código (um para este emoji, percorrível por `for...of`) e grafemas percebidos pela pessoa (que podem envolver vários pontos de código). `codePointAt` lê um ponto de código, enquanto `normalize()` permite comparar sequências canonicamente equivalentes; normalizar não resolve todas as regras de língua nem segmentação visual. Exemplo A: 'é' pré-composto e 'e' seguido de acento combinante podem parecer iguais e ter comprimentos diferentes. Exemplo B: conte pontos de código com `[...texto].length` e explique por que isso não é contador universal de caracteres visuais. A ponte antecede 05.11.","stageBridgeTitle":"Texto, array, Unicode e regex","assessmentEnvironment":"javascript","autoTested":true,"preparation":{"guided":true,"stageTitle":"TEXTO, ARRAYS E REGEX","introduction":"Desenhe uma caixa por identidade e anote o conteúdo de cada nome após cada linha.","explanation":"Atribuir uma variável cria outro nome para o mesmo array; uma cópia precisa de nova identidade.","conceptSteps":["Atribuir uma variável cria outro nome para o mesmo array; uma cópia precisa de nova identidade.","Alias acidental muda estado compartilhado sem que o chamador espere."],"vocabulary":[],"workedExample":{"steps":["Numa agenda, agendaB=agendaA faz ambos apontarem à mesma lista.","Adicionar pausa por B aparece ao ler A. agendaC=agendaA.slice() cria lista independente; adicionar almoço a C não muda A."]},"notes":["Confundir alias com cópia; acompanhar identidade antes e depois de cada mutação.","Alias acidental muda estado compartilhado sem que o chamador espere."],"docs":[{"title":"MDN Array","url":"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array","section":"","question":""},{"title":"MDN slice","url":"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/slice","section":"","question":""}],"materials":[],"predictionGuide":"Desenhe uma caixa por identidade e anote o conteúdo de cada nome após cada linha. Antes do primeiro Run, dica ou solução.","practiceSteps":["Rastreie o código linha por linha: desenhe quais nomes compartilham o mesmo array, preveja a saída e explique qual operação criou uma lista independente."],"hints":["Releia o enunciado e separe entrada, saída e restrições: Rastreie o código linha por linha: desenhe quais nomes compartilham o mesmo array, preveja a saída e explique qual operação criou uma lista independente.","Compare com o exemplo público — dado: saída. Esperado: [1,2],[1,2],[1,2]; antes do pop, a e b são [1,2,3].","Cuidado com a armadilha desta atividade: Confundir alias com cópia; acompanhar identidade antes e depois de cada mutação."],"reflectionPrompt":"Compare sua primeira resposta com o resultado da tentativa. Explique a regra que você praticou e um erro que ela ajuda a evitar."},"hints":["Releia o enunciado e separe entrada, saída e restrições: Rastreie o código linha por linha: desenhe quais nomes compartilham o mesmo array, preveja a saída e explique qual operação criou uma lista independente.","Compare com o exemplo público — dado: saída. Esperado: [1,2],[1,2],[1,2]; antes do pop, a e b são [1,2,3].","Cuidado com a armadilha desta atividade: Confundir alias com cópia; acompanhar identidade antes e depois de cada mutação."]},"assessment":{"version":1,"checks":["behavior"],"environment":"javascript","testPath":"__devpath_tests__.js","referenceDir":"solutions/05.01","predictionTable":{"version":1,"instructions":"Preencha cada valor antes de executar. Após a execução, compare cada resposta com o valor observado; respostas livres não recebem nota automática.","fields":[{"id":"a","label":"a depois das operações"},{"id":"b","label":"b depois das operações"},{"id":"c","label":"c depois das operações"},{"id":"mesmaRaiz","label":"a === b"},{"id":"copiaIndependente","label":"a !== c"}]},"assertionCases":[{"id":"05.01.alias-e-copia-rasa-compartil-2b0836e3","sourceTestPath":"tests/05.01.test.js","testName":"alias e cópia rasa compartilham referências em pontos diferentes","inputExpression":"estado.a","matcher":"toEqual","expectedExpression":"[1, 2]","negated":false,"initialArrangementExpression":"const estado = observarReferencias();","assertionExpression":"expect(estado.a).toEqual([1, 2])","contractRule":"estado.a toEqual [1, 2]","investigation":"Confira a expressão de entrada e a comparação toEqual deste caso: expect(estado.a).toEqual([1, 2])","assertionOffset":224,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"05.01.alias-e-copia-rasa-compartil-3d8336ed","sourceTestPath":"tests/05.01.test.js","testName":"alias e cópia rasa compartilham referências em pontos diferentes","inputExpression":"estado.b","matcher":"toEqual","expectedExpression":"[1, 2]","negated":false,"initialArrangementExpression":"const estado = observarReferencias();\n  expect(estado.a).toEqual([1, 2]);","assertionExpression":"expect(estado.b).toEqual([1, 2])","contractRule":"estado.b toEqual [1, 2]","investigation":"Confira a expressão de entrada e a comparação toEqual deste caso: expect(estado.b).toEqual([1, 2])","assertionOffset":313,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"05.01.alias-e-copia-rasa-compartil-d92c999c","sourceTestPath":"tests/05.01.test.js","testName":"alias e cópia rasa compartilham referências em pontos diferentes","inputExpression":"estado.c","matcher":"toEqual","expectedExpression":"[1, 2]","negated":false,"initialArrangementExpression":"const estado = observarReferencias();\n  expect(estado.a).toEqual([1, 2]);\n  expect(estado.b).toEqual([1, 2]);","assertionExpression":"expect(estado.c).toEqual([1, 2])","contractRule":"estado.c toEqual [1, 2]","investigation":"Confira a expressão de entrada e a comparação toEqual deste caso: expect(estado.c).toEqual([1, 2])","assertionOffset":402,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"05.01.alias-e-copia-rasa-compartil-27a381f6","sourceTestPath":"tests/05.01.test.js","testName":"alias e cópia rasa compartilham referências em pontos diferentes","inputExpression":"estado.mesmaRaiz","matcher":"toBe","expectedExpression":"true","negated":false,"initialArrangementExpression":"const estado = observarReferencias();\n  expect(estado.a).toEqual([1, 2]);\n  expect(estado.b).toEqual([1, 2]);\n  expect(estado.c).toEqual([1, 2]);","assertionExpression":"expect(estado.mesmaRaiz).toBe(true)","contractRule":"estado.mesmaRaiz toBe true","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(estado.mesmaRaiz).toBe(true)","assertionOffset":491,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"05.01.alias-e-copia-rasa-compartil-0558a1a0","sourceTestPath":"tests/05.01.test.js","testName":"alias e cópia rasa compartilham referências em pontos diferentes","inputExpression":"estado.copiaIndependente","matcher":"toBe","expectedExpression":"true","negated":false,"initialArrangementExpression":"const estado = observarReferencias();\n  expect(estado.a).toEqual([1, 2]);\n  expect(estado.b).toEqual([1, 2]);\n  expect(estado.c).toEqual([1, 2]);\n  expect(estado.mesmaRaiz).toBe(true);","assertionExpression":"expect(estado.copiaIndependente).toBe(true)","contractRule":"estado.copiaIndependente toBe true","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(estado.copiaIndependente).toBe(true)","assertionOffset":583,"assertionApi":"expect","executionScope":"browser-behavior-suite"}],"sourceTestPath":"tests/05.01.test.js","tests":"import {observarReferencias} from './main.js';\n\ntest('alias e cópia rasa compartilham referências em pontos diferentes', () => {\n  const estado = observarReferencias();\n  /*@case 05.01.alias-e-copia-rasa-compartil-2b0836e3*/expect(estado.a).toEqual([1, 2]);\n  /*@case 05.01.alias-e-copia-rasa-compartil-3d8336ed*/expect(estado.b).toEqual([1, 2]);\n  /*@case 05.01.alias-e-copia-rasa-compartil-d92c999c*/expect(estado.c).toEqual([1, 2]);\n  /*@case 05.01.alias-e-copia-rasa-compartil-27a381f6*/expect(estado.mesmaRaiz).toBe(true);\n  /*@case 05.01.alias-e-copia-rasa-compartil-0558a1a0*/expect(estado.copiaIndependente).toBe(true);\n});\n"},"reference":[{"path":"main.js","content":"export function observarReferencias() {\n  const a = [1, 2];\n  const b = a;\n  const c = a.slice();\n  a.push(3);\n  b.pop();\n  return {a, b, c, mesmaRaiz: a === b, copiaIndependente: a !== c};\n}\n\nconsole.log(JSON.stringify(observarReferencias()));\n"}],"prediction":{"a":"[1,2]","b":"[1,2]","c":"[1,2]","mesmaRaiz":"true","copiaIndependente":"true"}},{"item":{"id":"05.03","title":"Parsons de slug","stage":"05","kind":"PARSONS","contentVersion":2,"optional":false,"duration":"13 min","runtime":"Node.js 24 LTS · ECMAScript 2026 · módulos ES","compatibility":"trim, split, filter e join estão no baseline ECMAScript. O callback de filter recebe cada parte; esta atividade apresenta essa chamada antes de exigir que o aluno escreva outros callbacks.","objective":"Escreva a ordem das etapas e a forma dos arrays intermediários antes de ordenar os blocos.","prompt":"Complete a função slug(titulo) usando os blocos. filter chama o callback para cada parte e mantém só as partes não vazias; registre os valores intermediários e explique a ordem.","firstResponse":{"action":"Escreva a ordem das etapas e a forma dos arrays intermediários antes de ordenar os blocos.","timing":"Antes de reordenar ou pedir dica."},"explanation":{"mental_model":"Separe responsabilidades: limpar bordas, padronizar caixa, dividir, filtrar vazios e juntar.","worked_example":"Para converter '  Norte  Sul ' em palavras com ponto: trim remove bordas; toLowerCase padroniza; split(' ') revela tokens vazios; filter recebe cada parte em um callback e mantém as não vazias; join('.') forma a saída.","common_trap":"Juntar logo após split conserva tokens vazios como separadores duplicados. O callback de filter é chamado para cada parte; não acrescente remoção de acentos sem requisito.","why_it_matters":"Pipelines legíveis tornam regras de formatação mais fáceis de revisar e mudar."},"interaction":"Blocos reordenáveis por mouse e teclado, com controles mover acima/abaixo. O enunciado fixa a função que contém os blocos e explica que filter chama o callback uma vez por parte.","resources":["MDN trim: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/String/trim","MDN split: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/String/split","MDN join: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/join"],"starterFiles":[{"path":"main.js","content":"export function slug(titulo) {\n  const limpo = titulo.trim();\n  const minusculo = limpo.toLowerCase();\n  const partes = minusculo.split(\" \");\n  const validas = partes.filter(parte => parte !== \"\");\n  return validas.join(\" \");\n}\n\nconsole.log(slug(\"Dragão Azul\"));\n"}],"assets":[],"examples":[{"given":"\"  Olá  Mundo  \"","expected":"\"olá-mundo\"; ordem A,B,C,D,E"}],"checks":[{"fixture":{"given":"\"  Olá  Mundo  \"","expected":"\"olá-mundo\"; ordem A,B,C,D,E"},"scoring":"Avalie ordem/seleção de blocos e comportamento final; não exija ordem entre blocos independentes."}],"constraints":[],"rubric":[],"learningMetadata":{"requires":["04.01"]},"edgeCases":["\"\" -> \"\"; \" A  B \" -> \"a-b\"; acentos são preservados"],"primers":["`partes.filter(parte => parte !== '')` chama a função entre parênteses uma vez para cada item e monta um array novo só com os itens cujo callback retorna um valor truthy — neste exemplo, `true`. É o mesmo que um `for...of` com `if` e `push`; funções como argumento são estudadas na etapa 07."],"review":{"prompt":"Ao dividir por um espaço literal, de onde podem surgir tokens vazios?","choices":["De espaços repetidos entre palavras","Da conversão para minúsculas","Do método join executado antes do split"],"answer":0,"correctFeedback":"Separadores adjacentes deixam campos vazios no array.","incorrectFeedback":"trim só limpa as bordas; delimitadores adjacentes no interior ainda criam posições vazias."},"assessmentEnvironment":"javascript","autoTested":true,"preparation":{"guided":true,"stageTitle":"TEXTO, ARRAYS E REGEX","introduction":"Escreva a ordem das etapas e a forma dos arrays intermediários antes de ordenar os blocos.","explanation":"Separe responsabilidades: limpar bordas, padronizar caixa, dividir, filtrar vazios e juntar.","conceptSteps":["Separe responsabilidades: limpar bordas, padronizar caixa, dividir, filtrar vazios e juntar.","Pipelines legíveis tornam regras de formatação mais fáceis de revisar e mudar."],"vocabulary":[],"workedExample":{"steps":["Para converter ' Norte Sul ' em palavras com ponto: trim remove bordas; toLowerCase padroniza; split(' ') revela tokens vazios; filter recebe cada parte em um callback e mantém as não vazias; join('.') forma a saída."]},"notes":["Juntar logo após split conserva tokens vazios como separadores duplicados. O callback de filter é chamado para cada parte; não acrescente remoção de acentos sem requisito.","Pipelines legíveis tornam regras de formatação mais fáceis de revisar e mudar."],"docs":[{"title":"MDN trim","url":"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/String/trim","section":"","question":""},{"title":"MDN split","url":"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/String/split","section":"","question":""},{"title":"MDN join","url":"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/join","section":"","question":""}],"materials":[],"predictionGuide":"Escreva a ordem das etapas e a forma dos arrays intermediários antes de ordenar os blocos. Antes de reordenar ou pedir dica.","practiceSteps":["Complete a função slug(titulo) usando os blocos. filter chama o callback para cada parte e mantém só as partes não vazias; registre os valores intermediários e explique a ordem."],"hints":["Releia o enunciado e separe entrada, saída e restrições: Complete a função slug(titulo) usando os blocos. filter chama o callback para cada parte e mantém só as partes não vazias; registre os valores intermediários e explique a ordem.","Compare com o exemplo público — dado: \" Olá Mundo \". Esperado: \"olá-mundo\"; ordem A,B,C,D,E.","Cuidado com a armadilha desta atividade: Juntar logo após split conserva tokens vazios como separadores duplicados."],"reflectionPrompt":"Compare sua primeira resposta com o resultado da tentativa. Explique a regra que você praticou e um erro que ela ajuda a evitar."},"hints":["Releia o enunciado e separe entrada, saída e restrições: Complete a função slug(titulo) usando os blocos. filter chama o callback para cada parte e mantém só as partes não vazias; registre os valores intermediários e explique a ordem.","Compare com o exemplo público — dado: \" Olá Mundo \". Esperado: \"olá-mundo\"; ordem A,B,C,D,E.","Cuidado com a armadilha desta atividade: Juntar logo após split conserva tokens vazios como separadores duplicados."]},"assessment":{"version":1,"checks":["behavior"],"environment":"javascript","testPath":"__devpath_tests__.js","referenceDir":"solutions/05.03","assertionCases":[{"id":"05.03.normaliza-caixa-e-espacos-pa-2c16f717","sourceTestPath":"tests/05.03.test.js","testName":"normaliza caixa e espaços para montar um slug","inputExpression":"slug('  Dragão   Azul ')","matcher":"toBe","expectedExpression":"'dragão-azul'","negated":false,"initialArrangementExpression":"sem setup anterior dentro deste teste","assertionExpression":"expect(slug('  Dragão   Azul ')).toBe('dragão-azul')","contractRule":"slug('  Dragão   Azul ') toBe 'dragão-azul'","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(slug('  Dragão   Azul ')).toBe('dragão-azul')","assertionOffset":150,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"05.03.normaliza-caixa-e-espacos-pa-9b5b332a","sourceTestPath":"tests/05.03.test.js","testName":"normaliza caixa e espaços para montar um slug","inputExpression":"slug('A B')","matcher":"toBe","expectedExpression":"'a-b'","negated":false,"initialArrangementExpression":"expect(slug('  Dragão   Azul ')).toBe('dragão-azul');","assertionExpression":"expect(slug('A B')).toBe('a-b')","contractRule":"slug('A B') toBe 'a-b'","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(slug('A B')).toBe('a-b')","assertionOffset":259,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"05.03.texto-vazio-permanece-vazio--85f5aee9","sourceTestPath":"tests/05.03.test.js","testName":"texto vazio permanece vazio após remover espaços","inputExpression":"slug('   ')","matcher":"toBe","expectedExpression":"''","negated":false,"initialArrangementExpression":"sem setup anterior dentro deste teste","assertionExpression":"expect(slug('   ')).toBe('')","contractRule":"slug('   ') toBe ''","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(slug('   ')).toBe('')","assertionOffset":417,"assertionApi":"expect","executionScope":"browser-behavior-suite"}],"sourceTestPath":"tests/05.03.test.js","tests":"import {slug} from './main.js';\n\ntest('normaliza caixa e espaços para montar um slug', () => {\n  /*@case 05.03.normaliza-caixa-e-espacos-pa-2c16f717*/expect(slug('  Dragão   Azul ')).toBe('dragão-azul');\n  /*@case 05.03.normaliza-caixa-e-espacos-pa-9b5b332a*/expect(slug('A B')).toBe('a-b');\n});\n\ntest('texto vazio permanece vazio após remover espaços', () => {\n  /*@case 05.03.texto-vazio-permanece-vazio--85f5aee9*/expect(slug('   ')).toBe('');\n});\n"},"reference":[{"path":"main.js","content":"export function slug(titulo) {\n  const limpo = titulo.trim();\n  const minusculo = limpo.toLowerCase();\n  const partes = minusculo.split(\" \");\n  const validas = partes.filter(parte => parte !== \"\");\n  return validas.join(\"-\");\n}\n\nconsole.log(slug(\"Dragão Azul\"));\n"}]},{"item":{"id":"06.01","title":"Leitura de referências","stage":"06","kind":"PREDICT","contentVersion":2,"optional":false,"duration":"13 min","runtime":"Node.js 24 LTS · ECMAScript 2026 · módulos ES","compatibility":"Referências e spread são ECMAScript; sem pressupor layout físico stack/heap.","objective":"Desenhe referências e preveja identidades e campos alterados, linha a linha.","prompt":"Rastreie as identidades do objeto e da propriedade aninhada antes/depois de cada atribuição; escreva a previsão e explique o alcance de spread raso.","firstResponse":{"action":"Desenhe referências e preveja identidades e campos alterados, linha a linha.","timing":"Antes do primeiro Run."},"explanation":{"mental_model":"Atribuição compartilha identidade; spread cria novo externo, mas copia referências internas.","worked_example":"Dois nomes apontam à mesma ficha de reserva; mudança é visível por ambos. Uma cópia rasa separa campo externo, mas ainda compartilha objeto contato.","common_trap":"Supor que spread clona a árvore inteira; comparar referências externas e aninhadas com ===.","why_it_matters":"O alcance real da cópia evita efeitos laterais em dados aninhados."},"interaction":"Grafo de referências editável com tabela textual equivalente, operável por teclado.","resources":["MDN spread: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Operators/Spread_syntax","MDN objetos: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Working_with_objects"],"starterFiles":[{"path":"main.js","content":"export function observarAliasing() {\n  const base = {pontos: 1, meta: {ativo: true}};\n  const alias = base;\n  const copia = {...base};\n  alias.pontos = 2;\n  copia.meta.ativo = false;\n  return {pontos: base.pontos, ativo: base.meta.ativo, mesmaRaiz: base === copia, mesmoMeta: base.meta === copia.meta};\n}\n\nconsole.log(JSON.stringify(observarAliasing()));\n"}],"assets":[],"examples":[{"given":"a.pontos/b.pontos/c.pontos","expected":"2,2,1; a.meta.ativo/c.meta.ativo -> false,false"}],"checks":[{"fixture":{"given":"a.pontos/b.pontos/c.pontos","expected":"2,2,1; a.meta.ativo/c.meta.ativo -> false,false"},"scoring":"Compare resposta registrada antes de Run com sequência/valor previstos; confiança é diagnóstica."}],"constraints":[],"rubric":[],"learningMetadata":{"requires":["05.01"]},"edgeCases":["c.pontos=9 -> a.pontos continua 2; b.meta={ativo:true} -> a.meta muda por alias b=a"],"review":{"prompt":"Por que um diagrama de referências ajuda a investigar objetos compartilhados?","choices":["Ele substitui a necessidade de acompanhar atribuições feitas durante a execução.","Ele separa os nomes das variáveis dos objetos que esses nomes podem referenciar.","Ele prova igualdade profunda sempre que dois nomes aparecem perto um do outro."],"answer":1,"correctFeedback":"Correto: nomes são bindings e objetos são identidades; desenhar essa relação torna a leitura do fluxo mais clara.","incorrectFeedback":"Proximidade de nomes não mostra identidade. Acompanhe quais objetos são criados e a quais deles cada binding se liga."},"stageBridge":"`const a={x:1}; const b=a; b.x=2` faz `a.x` valer 2 porque ambos referem o mesmo objeto. `const c={...a}` cria outro objeto externo, mas objetos aninhados continuam compartilhados. `structuredClone` pode copiar certos grafos de dados, com limites e tipos suportados; JSON não é clone universal e pode perder tipos. Em uma cadeia de protótipos, `'x' in objeto` consulta a cadeia; `Object.hasOwn(objeto,'x')` pergunta se o objeto possui a propriedade. `Object.keys` lista propriedades próprias enumeráveis, não tudo que `in` encontra. Descriptor mostra, por exemplo, se uma propriedade é enumerável ou gravável. Esses conceitos aparecem antes de `class` e `this` para que “herança” não seja uma caixa preta. “Stack/heap” aqui é analogia didática, não promessa do layout interno do motor JavaScript.\r\n\r\nAntes de `06.06`, um JSON com sintaxe inválida lança um erro de parse. `try/catch` delimita somente essa operação: o `catch` converte a falha de sintaxe em `null`; JSON sintaticamente válido ainda precisa de validação de esquema separada. Mais tarde, a etapa 13 amplia esse modelo para classes de erro, causas e diagnóstico, sem tratar `catch` como validação automática.","stageBridgeTitle":"Objeto próprio, herança e referência","assessmentEnvironment":"javascript","autoTested":true,"preparation":{"guided":true,"stageTitle":"OBJETOS E REFERÊNCIAS","introduction":"Desenhe referências e preveja identidades e campos alterados, linha a linha.","explanation":"Atribuição compartilha identidade; spread cria novo externo, mas copia referências internas.","conceptSteps":["Atribuição compartilha identidade; spread cria novo externo, mas copia referências internas.","O alcance real da cópia evita efeitos laterais em dados aninhados."],"vocabulary":[],"workedExample":{"steps":["Dois nomes apontam à mesma ficha de reserva; mudança é visível por ambos.","Uma cópia rasa separa campo externo, mas ainda compartilha objeto contato."]},"notes":["Supor que spread clona a árvore inteira; comparar referências externas e aninhadas com ===.","O alcance real da cópia evita efeitos laterais em dados aninhados."],"docs":[{"title":"MDN spread","url":"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Operators/Spread_syntax","section":"","question":""},{"title":"MDN objetos","url":"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Working_with_objects","section":"","question":""}],"materials":[],"predictionGuide":"Desenhe referências e preveja identidades e campos alterados, linha a linha. Antes do primeiro Run.","practiceSteps":["Rastreie as identidades do objeto e da propriedade aninhada antes/depois de cada atribuição; escreva a previsão e explique o alcance de spread raso."],"hints":["Releia o enunciado e separe entrada, saída e restrições: Rastreie as identidades do objeto e da propriedade aninhada antes/depois de cada atribuição; escreva a previsão e explique o alcance de spread raso.","Compare com o exemplo público — dado: a.pontos/b.pontos/c.pontos. Esperado: 2,2,1; a.meta.ativo/c.meta.ativo -> false,false.","Cuidado com a armadilha desta atividade: Supor que spread clona a árvore inteira; comparar referências externas e aninhadas com ===."],"reflectionPrompt":"Compare sua primeira resposta com o resultado da tentativa. Explique a regra que você praticou e um erro que ela ajuda a evitar."},"hints":["Releia o enunciado e separe entrada, saída e restrições: Rastreie as identidades do objeto e da propriedade aninhada antes/depois de cada atribuição; escreva a previsão e explique o alcance de spread raso.","Compare com o exemplo público — dado: a.pontos/b.pontos/c.pontos. Esperado: 2,2,1; a.meta.ativo/c.meta.ativo -> false,false.","Cuidado com a armadilha desta atividade: Supor que spread clona a árvore inteira; comparar referências externas e aninhadas com ===."]},"assessment":{"version":1,"checks":["behavior"],"environment":"javascript","testPath":"__devpath_tests__.js","referenceDir":"solutions/06.01","predictionTable":{"version":1,"instructions":"Preencha cada valor antes de executar. Após a execução, compare cada resposta com o valor observado; respostas livres não recebem nota automática.","fields":[{"id":"pontos","label":"base.pontos"},{"id":"ativo","label":"base.meta.ativo"},{"id":"mesmaRaiz","label":"base === copia"},{"id":"mesmoMeta","label":"base.meta === copia.meta"}]},"assertionCases":[{"id":"06.01.copia-rasa-mantem-o-objeto-a-d60061ed","sourceTestPath":"tests/06.01.test.js","testName":"cópia rasa mantém o objeto aninhado compartilhado","inputExpression":"observarAliasing()","matcher":"toEqual","expectedExpression":"{pontos: 2, ativo: false, mesmaRaiz: false, mesmoMeta: true}","negated":false,"initialArrangementExpression":"sem setup anterior dentro deste teste","assertionExpression":"expect(observarAliasing()).toEqual({pontos: 2, ativo: false, mesmaRaiz: false, mesmoMeta: true})","contractRule":"observarAliasing() toEqual {pontos: 2, ativo: false, mesmaRaiz: false, mesmoMeta: true}","investigation":"Confira a expressão de entrada e a comparação toEqual deste caso: expect(observarAliasing()).toEqual({pontos: 2, ativo: false, mesmaRaiz: false, mesmoMeta: true})","assertionOffset":166,"assertionApi":"expect","executionScope":"browser-behavior-suite"}],"sourceTestPath":"tests/06.01.test.js","tests":"import {observarAliasing} from './main.js';\n\ntest('cópia rasa mantém o objeto aninhado compartilhado', () => {\n  /*@case 06.01.copia-rasa-mantem-o-objeto-a-d60061ed*/expect(observarAliasing()).toEqual({pontos: 2, ativo: false, mesmaRaiz: false, mesmoMeta: true});\n});\n"},"reference":[{"path":"main.js","content":"export function observarAliasing() {\n  const base = {pontos: 1, meta: {ativo: true}};\n  const alias = base;\n  const copia = {...base};\n  alias.pontos = 2;\n  copia.meta.ativo = false;\n  return {pontos: base.pontos, ativo: base.meta.ativo, mesmaRaiz: base === copia, mesmoMeta: base.meta === copia.meta};\n}\n\nconsole.log(JSON.stringify(observarAliasing()));\n"}],"prediction":{"pontos":"2","ativo":"false","mesmaRaiz":"false","mesmoMeta":"true"}},{"item":{"id":"06.02","title":"Aliasing visual","stage":"06","kind":"TRACE","contentVersion":2,"optional":false,"duration":"15 min","runtime":"Node.js 24 LTS · ECMAScript 2026 · módulos ES","compatibility":"Objetos, spread e referências padrão; grafo representa semântica, não endereços.","objective":"Desenhe o grafo antes/depois da reatribuição e rotule objetos compartilhados.","prompt":"Complete o grafo de referências após spread, mutação e reatribuição. Anote quais caminhos compartilham alvo em cada etapa e justifique.","firstResponse":{"action":"Desenhe o grafo antes/depois da reatribuição e rotule objetos compartilhados.","timing":"Antes da execução do rastreamento."},"explanation":{"mental_model":"Spread copia arestas da camada externa; reatribuir propriedade na cópia muda sua aresta, não o alvo da origem.","worked_example":"Origem e 