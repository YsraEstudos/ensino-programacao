 público — dado: Ana 10, Bia 10, Cai 8. Esperado: Ana,Bia,Cai; partida inválida não gera pontos.","Cuidado com a armadilha desta atividade: Não converta pontos numéricos em texto nem deixe o segundo critério sobrescrever uma diferença decisiva do primeiro."]},"assessment":{"version":1,"checks":["behavior"],"environment":"javascript","testPath":"__devpath_tests__.js","referenceDir":"solutions/07.03","assertionCases":[{"id":"07.03.pontua-partidas-validas-e-or-0f2d99dd","sourceTestPath":"tests/07.03.test.js","testName":"pontua partidas válidas e ordena por pontos decrescentes e nome crescente","inputExpression":"ranking([\n    {id: 'x', jogador: 'Bia', valida: true, pontos: 8},\n    {id: 'y', jogador: 'Ana', valida: true, pontos: 8},\n    {id: 'z', jogador: 'Cris', valida: false, pontos: 20},\n  ])","matcher":"toEqual","expectedExpression":"['y', 'x']","negated":false,"initialArrangementExpression":"sem setup anterior dentro deste teste","assertionExpression":"expect(ranking([\n    {id: 'x', jogador: 'Bia', valida: true, pontos: 8},\n    {id: 'y', jogador: 'Ana', valida: true, pontos: 8},\n    {id: 'z', jogador: 'Cris', valida: false, pontos: 20},\n  ])).toEqual(['y', 'x'])","contractRule":"ranking([\n    {id: 'x', jogador: 'Bia', valida: true, pontos: 8},\n    {id: 'y', jogador: 'Ana', valida: true, pontos: 8},\n    {id: 'z', jogador: 'Cris', valida: false, pontos: 20},\n  ]) toEqual ['y', 'x']","investigation":"Confira a expressão de entrada e a comparação toEqual deste caso: expect(ranking([\n    {id: 'x', jogador: 'Bia', valida: true, pontos: 8},\n    {id: 'y', jogador: 'Ana', valida: true, pontos: 8},\n    {id: 'z', jogador: 'Cris', valida: false, pontos: 20},\n  ])).toEqual(['y', 'x'])","assertionOffset":181,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"07.03.pontua-partidas-validas-e-or-766d8633","sourceTestPath":"tests/07.03.test.js","testName":"pontua partidas válidas e ordena por pontos decrescentes e nome crescente","inputExpressi