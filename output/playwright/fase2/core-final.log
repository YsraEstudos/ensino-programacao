urn; }\n  const g = x => x + 1;\n  const h = x => { x + 1; };\n  return {a: a(), b: b(), c: c(3), dPositivo: d(4), dNegativo: d(-1), e: e(), f: f(), g: g(1), h: h(1)};\n}\n\nconst resultado = preverRetornos();\nconsole.log(JSON.stringify(Object.fromEntries(Object.entries(resultado).map(([chave, valor]) => [chave, valor === undefined ? \"undefined\" : valor]))));\n"}],"prediction":{"a":"2","b":"undefined","c":"6","dPositivo":"4","dNegativo":"undefined","e":"null","f":"undefined","g":"2","h":"undefined"}},{"item":{"id":"04.03","title":"Parsons de decomposição","stage":"04","kind":"PARSONS","contentVersion":2,"optional":false,"duration":"14 min","runtime":"Node.js 24 LTS · ECMAScript 2026 · módulos ES","compatibility":"Sintaxe e APIs padrão disponíveis no Node.js 24 LTS; sem dependências externas.","objective":"Desenhe setas de cada função usada para quem a chama; escreva uma ordem válida antes de mover os blocos.","prompt":"Organize os blocos reconhecendo a diferença entre criar uma arrow function e executar seu corpo. A, B e C podem ser declarados em qualquer ordem; a chamada D deve acontecer depois das três declarações. Indique duas ordens válidas para A, B e C.","firstResponse":{"action":"Desenhe setas de cada função usada para quem a chama; escreva uma ordem válida antes de mover os blocos.","timing":"Antes de executar, pedir dica ou abrir a solução."},"explanation":{"mental_model":"Uma função composta usa outras funções disponíveis no contexto. Dependências formam uma ordem parcial: blocos independentes não têm precedência entre si.","worked_example":"Num gerador de mensagem, `validarCodigo` e `buscarDescricao` são auxiliares independentes; `montarMensagem` usa as duas quando é chamada. A declaração de `montarMensagem` pode vir antes das auxiliares, mas ambas precisam estar inicializadas antes da chamada; entre si, podem trocar de ordem.","common_trap":"Ordenar pela posição no enunciado ou misturar cálculo e apresentação esconde as dependências reais.","why_it_matters":"Decompor torna regras testáveis e permite mudar cálculo ou formato sem reescrever a composição."},"interaction":"Blocos reordenáveis por teclado (selecionar e mover para cima/baixo) ou resposta com sequência textual. Execute depois para conferir disponibilidade.","resources":["Blocos A–D do starter.","Espaço para registrar dependências/sequência.","Console para conferir a chamada final."],"starterFiles":[{"path":"main.js","content":"// A reconstrução precisa aplicar a conversão antes de formatar o valor.\nexport const exibir = celsius => formatar(celsius);\nexport const cParaF = celsius => celsius * 9 / 5 + 32;\nexport const formatar = fahrenheit => `${fahrenheit} °F`;\n"}],"assets":[],"examples":[{"given":"A, B e C podem ser declarados em qualquer ordem; execute D depois das três inicializações","expected":"32 °F"}],"checks":[{"fixture":{"given":"A, B e C podem ser declarados em qualquer ordem; execute D depois das três inicializações","expected":"32 °F"},"scoring":"Avalie ordem/seleção de blocos e comportamento final; não exija ordem entre blocos independentes."}],"constraints":[],"rubric":[],"learningMetadata":{"requires":["03.04"]},"edgeCases":["Declare C antes de A e B; A e B podem trocar de ordem; D depois dos três -> exibir(100) retorna 212 °F"],"review":{"prompt":"Qual é a diferença entre declarar uma arrow function e executar o corpo dela?","choices":["A declaração disponibiliza a função; o corpo só executa quando alguma chamada a invoca.","O corpo executa imediatamente ao final da declaração, mesmo sem nenhuma chamada.","A declaração executa e guarda o resultado, que as chamadas futuras apenas reutilizam."],"answer":0,"correctFeedback":"Isso: a declaração cria a função; a execução das instruções acontece quando ela é chamada.","incorrectFeedback":"Separe a criação da função da execução do corpo. Declarar uma arrow, por si só, não executa suas instruções."},"assessmentEnvironment":"javascript","autoTested":true,"preparation":{"guided":true,"stageTitle":"FUNÇÕES, RETORNO E ERROS","introduction":"Desenhe setas de cada função usada para quem a chama; escreva uma ordem válida antes de mover os blocos.","explanation":"Uma função composta usa outras funções disponíveis no contexto. Dependências formam uma ordem parcial: blocos independentes não têm precedência entre si.","conceptSteps":["Uma função composta usa outras funções disponíveis no contexto.","Dependências formam uma ordem parcial: blocos independentes não têm precedência entre si.","Decompor torna regras testáveis e permite mudar cálculo ou formato sem reescrever a composição."],"vocabulary":["`validarCodigo` — Num gerador de mensagem, `validarCodigo` e `buscarDescricao` são auxiliares independentes; `montarMensagem` usa as duas quando é chamada.","`buscarDescricao` — Num gerador de mensagem, `validarCodigo` e `buscarDescricao` são auxiliares independentes; `montarMensagem` usa as duas quando é chamada.","`montarMensagem` — Num gerador de mensagem, `validarCodigo` e `buscarDescricao` são auxiliares independentes; `montarMensagem` usa as duas quando é chamada."],"workedExample":{"steps":["Num gerador de mensagem, `validarCodigo` e `buscarDescricao` são auxiliares independentes; `montarMensagem` usa as duas quando é chamada.","A declaração de `montarMensagem` pode vir antes das auxiliares, mas ambas precisam estar inicializadas antes da chamada; entre si, podem trocar de ordem."]},"notes":["Ordenar pela posição no enunciado ou misturar cálculo e apresentação esconde as dependências reais.","Decompor torna regras testáveis e permite mudar cálculo ou formato sem reescrever a composição."],"docs":[],"materials":["Blocos A–D do starter.","Espaço para registrar dependências/sequência.","Console para conferir a chamada final."],"predictionGuide":"Desenhe setas de cada função usada para quem a chama; escreva uma ordem válida antes de mover os blocos. Antes de executar, pedir dica ou abrir a solução.","practiceSteps":["Organize os blocos reconhecendo a diferença ent