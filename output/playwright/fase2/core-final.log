oria: 'brinde', preco: 0}])).toEqual({brinde: 0})","contractRule":"resumirPorCategoria([{categoria: 'brinde', preco: 0}]) toEqual {brinde: 0}","investigation":"Confira a expressão de entrada e a comparação toEqual deste caso: expect(resumirPorCategoria([{categoria: 'brinde', preco: 0}])).toEqual({brinde: 0})","assertionOffset":664,"assertionApi":"expect","executionScope":"browser-behavior-suite"}],"sourceTestPath":"tests/07.06.test.js","tests":"import {resumirPorCategoria} from './main.js';\n\ntest('agrupar e somar por categoria preserva acumulados independentes', () => {\n  const itens = [\n    {categoria: 'A', preco: 2},\n    {categoria: 'A', preco: 3},\n    {categoria: 'B', preco: 4},\n  ];\n  /*@case 07.06.agrupar-e-somar-por-categori-88ba5a20*/expect(resumirPorCategoria(itens)).toEqual({A: 5, B: 4});\n  /*@case 07.06.agrupar-e-somar-por-categori-09f8f9af*/expect(itens).toEqual([\n    {categoria: 'A', preco: 2},\n    {categoria: 'A', preco: 3},\n    {categoria: 'B', preco: 4},\n  ]);\n});\n\ntest('uma categoria com preço zero continua presente', () => {\n  /*@case 07.06.uma-categoria-com-preco-zero-9b6c667d*/expect(resumirPorCategoria([{categoria: 'brinde', preco: 0}])).toEqual({brinde: 0});\n});\n"},"reference":[{"path":"main.js","content":"export function resumirPorCategoria(itens) {\n  return itens.reduce((acumulado, item) => {\n    acumulado[item.categoria] = (acumulado[item.categoria] ?? 0) + item.preco;\n    return acumulado;\n  }, {});\n}\n"}]},{"item":{"id":"08.01","title":"Classifique a complexidade","stage":"08","kind":"PREDICT","contentVersion":2,"optional":false,"duration":"17 min","runtime":"Node.js 24 LTS · ECMAScript 2026 · módulos ES","compatibility":"Node.js 24 LTS with ESM unless the card explicitly compares another context; use built-ins only and retain the contract’s stated fallback for newer APIs.","objective":"Classifique trechos sequenciais e aninhados antes de calcular crescimento.","prompt":"Use o starter descrito no contrato (snippets: acesso a[0]; varredura n; dois loops aninhados n; divisão por 2 repetida; sort; busca binária; Set.has médio; cópia de n itens). Antes de executar, escreva a saída/ordem e um traço por passo que justifique a transição decisiva; então compare com a execução.","firstResponse":{"action":"Classifique trechos sequenciais e aninhados antes de calcular crescimento.","timing":"Primeiros 2 min de 17 min, antes de executar."},"explanation":{"mental_model":"Trabalhos em sequência somam; só aninhamento repete o custo interno para cada item externo.","worked_example":"Um importador percorre o lote para contar linhas e depois percorre-o outra vez para validar extensões. São duas passagens; comparar cada arquivo com todos os demais criaria pares.","common_trap":"Loops consecutivos não se multiplicam; inclua sort e cópias no custo. Conte repetições em função de n.","why_it_matters":"Classificar etapas ajuda estimar o impacto de dobrar o lote antes de escolher uma implementação."},"interaction":"Tabela textual de previsão e execução, com linha/coluna para cada passo e campo de justificativa. Tab/Shift+Tab navega campos; cabeçalhos de tabela são anunciados e o resultado aparece em texto, sem depender de cor.","resources":["Starter para o estudante: snippets: acesso a[0]; varredura n; dois loops aninhados n; divisão por 2 repetida; sort; busca binária; Set.has médio; cópia de n itens (sem arquivo asset separado).","Entrada do exemplo público: ordens na sequência."],"starterFiles":[{"path":"main.js","content":"export const analises = [\n  {trecho: \"acesso por índice\", crescimento: \"O(1)\"},\n  {trecho: \"uma varredura\", crescimento: \"O(n)\"},\n  {trecho: \"dois laços aninhados\", crescimento: \"O(n²)\"},\n  {trecho: \"dividir por dois\", crescimento: \"O(log n)\"},\n  {trecho: \"ordenar\", crescimento: \"O(n log n)\"},\n  {trecho: \"busca binária\", crescimento: \"O(log n)\"},\n  {trecho: \"Set.has médio\", crescimento: \"O(1)\"},\n  {trecho: \"copiar n itens\", crescimento: \"O(n)\"},\n];\n\nconsole.log(JSON.stringify(analises));\n"}],"assets":[],"examples":[{"given":"ordens na sequência","expected":"O(1),O(n),O(n²),O(log n),O(n log n),O(log n),O(1) médio,O(n)"}],"checks":[{"fixture":{"given":"ordens na sequência","expected":"O(1),O(n),O(n²),O(log n),O(n log n),O(log n),O(1) médio,O(n)"},"scoring":"Compare resposta registrada antes de Run com sequência/valor previstos; confiança é diagnóstica."}],"constraints":[],"rubric":[],"learningMetadata":{"requires":["03.01","05.01","07.05"]},"edgeCases":["loop n com corpo constante extra -> O(n); dois loops consecutivos n+n -> O(n), não O(n²)"],"review":{"prompt":"Um algoritmo ordena uma coleção e depois faz uma única varredura. Qual termo representa o crescimento dominante?","choices":["`O(n²)`, porque duas operações sempre multiplicam seus custos.","`O(n log n)`, determinado pela ordenação, que domina a varredura linear.","`O(log n)`, porque uma ordenação reduz pela metade a coleção."],"answer":1,"correctFeedback":"Operações sequenciais somam custos; para tamanhos grandes, a ordenação domina a varredura linear.","incorrectFeedback":"A contagem sequencial não é automaticamente multiplicativa; compare as taxas de crescimento das operações."},"stageBridge":"Um grafo representa vértices e suas arestas; em um mapa sem pesos, BFS explora por camadas usando uma fila FIFO. Marque o vértice como visitado ao enfileirá-lo e guarde o predecessor na primeira descoberta. Assim ciclos não repetem trabalho e a cadeia de predecessores reconstrói um caminho mínimo.\r\n\r\nExemplo resolvido A: de A, enfileire B e C, nessa ordem. Exemplo resolvido B: ao remover B, descubra D e grave `anterior[D] = B`; C já está na fila, então não troque esse predecessor ao encontrar D outra vez. Exemplo com ajuda retirada: dado um mapa de estações com um ciclo, o aluno preenche a fila após cada remoção e reconstrói a rota de Central até Museu. A ponte antecede `08.07`, que pratica o traçado, e o planejador completo `08.08`.","stageBri