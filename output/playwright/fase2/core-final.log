onExpression":"expect(analises.map(item => item.crescimento)).toEqual(['O(1)', 'O(n)', 'O(n²)', 'O(log n)', 'O(n log n)', 'O(log n)', 'O(1)', 'O(n)'])","contractRule":"analises.map(item => item.crescimento) toEqual ['O(1)', 'O(n)', 'O(n²)', 'O(log n)', 'O(n log n)', 'O(log n)', 'O(1)', 'O(n)']","investigation":"Confira a expressão de entrada e a comparação toEqual deste caso: expect(analises.map(item => item.crescimento)).toEqual(['O(1)', 'O(n)', 'O(n²)', 'O(log n)', 'O(n log n)', 'O(log n)', 'O(1)', 'O(n)'])","assertionOffset":176,"assertionApi":"expect","executionScope":"browser-behavior-suite"}],"sourceTestPath":"tests/08.01.test.js","tests":"import {analises} from './main.js';\n\ntest('ordens de crescimento são associadas aos trechos na ordem publicada', () => {\n  /*@case 08.01.ordens-de-crescimento-sao-as-c0cd2fe0*/expect(analises.map(item => item.crescimento)).toEqual(['O(1)', 'O(n)', 'O(n²)', 'O(log n)', 'O(n log n)', 'O(log n)', 'O(1)', 'O(n)']);\n});\n"},"reference":[{"path":"main.js","content":"export const analises = [\n  {trecho: \"acesso por índice\", crescimento: \"O(1)\"},\n  {trecho: \"uma varredura\", crescimento: \"O(n)\"},\n  {trecho: \"dois laços aninhados\", crescimento: \"O(n²)\"},\n  {trecho: \"dividir por dois\", crescimento: \"O(log n)\"},\n  {trecho: \"ordenar\", crescimento: \"O(n log n)\"},\n  {trecho: \"busca binária\", crescimento: \"O(log n)\"},\n  {trecho: \"Set.has médio\", crescimento: \"O(1)\"},\n  {trecho: \"copiar n itens\", crescimento: \"O(n)\"},\n];\n\nconsole.log(JSON.stringify(analises));\n"}],"prediction":{"crescimentos":"[\"O(1)\",\"O(n)\",\"O(n²)\",\"O(log n)\",\"O(n log n)\",\"O(log n)\",\"O(1)\",\"O(n)\"]"}},{"item":{"id":"08.02","title":"Parsons recursivo","stage":"08","kind":"PARSONS","contentVersion":2,"optional":false,"duration":"20 min","runtime":"Node.js 24 LTS · ECMAScript 2026 · módulos ES","compatibility":"Node.js 24 LTS with ESM unless the card explicitly compares another context; use built-ins only and retain the contract’s stated fallback for newer APIs.","objective":"Preveja resultado para árvore vazia e folha antes de ordenar blocos.","prompt":"Use o starter descrito no contrato (blocos: A=if(no===null)return 0; B=const esquerda=somar(no.esq); C=const direita=somar(no.dir); D=return no.valor+esquerda+direita). Ordene ou selecione os blocos, entregue a sequência final e explique uma dependência entre etapas.","firstResponse":{"action":"Preveja resultado para árvore vazia e folha antes de ordenar blocos.","timing":"Primeiros 2 min de 20 min, antes de executar."},"explanation":{"mental_model":"Recursão em árvore combina caso base, chamadas menores e composição de resultados.","worked_example":"Para contar documentos, pasta ausente contribui zero; pasta existente soma seu documento e as contagens das subpastas. Cada chamada desce até ausência.","common_trap":"Sem caso base, a chamada passa da folha; combinar antes de receber descendentes perde dados. Trate null primeiro.","why_it_matters":"O mesmo padrão se aplica a diretórios, categorias e comentários hierárquicos."},"interaction":"Lista numerada de blocos com botões rotulados Mover para cima/baixo e envio da ordem final. Reordenação disponível por teclado sem arrastar; leitor de tela anuncia bloco e posição após cada movimento.","resources":["Starter para o estudante: blocos: A=if(no===null)return 0; B=const esquerda=somar(no.esq); C=const direita=somar(no.dir); D=return no.valor+esquerda+direita (sem arquivo asset separado).","Entrada do exemplo público: árvore raiz 1, filhos 2 e 3."],"starterFiles":[{"path":"main.js","content":"export function somar(no) {\n  if (no === null || no === undefined) return undefined;\n  const esquerda = somar(no.esq ?? null);\n  const direita = somar(no.dir ?? null);\n  return no.valor + esquerda + direita;\n}\n\nconsole.log(somar({valor: 2, esq: {valor: 3}, dir: {valor: 5}}));\n"}],"assets":[],"examples":[{"given":"árvore raiz 1, filhos 2 e 3","expected":"soma 6; ordem A antes de B/C antes de D"}],"checks":[{"fixture":{"given":"árvore raiz 1, filhos 2 e 3","expected":"soma 6; ordem A antes de B/C antes de D"},"scoring":"Avalie ordem/seleção de blocos e comportamento final; não exija ordem entre blocos independentes."}],"constraints":[],"rubric":[],"learningMetadata":{"requires":["03.01","05.01","06.01"]},"edgeCases":["árvore null -> 0; árvore de um nó valor -2 -> -2; B/C podem trocar"],"review":{"prompt":"Ao escrever uma função recursiva para agregar uma estrutura em árvore, o que torna o problema menor a cada chamada?","choices":["Repetir a chamada com a árvore inteira até o contador global mudar.","Pular a verificação de término e esperar que a pilha de chamadas limite o percurso.","Aplicar a mesma função às subárvores e combinar os resultados."],"answer":2,"correctFeedback":"A recursão progride quando cada chamada trata subproblemas menores e combina seus resultados.","incorrectFeedback":"Uma chamada precisa aproximar-se do caso base; repetir o mesmo problema não garante término."},"assessmentEnvironment":"javascript","autoTested":true,"preparation":{"guided":true,"stageTitle":"COMPLEXIDADE E RECURSÃO","introduction":"Preveja resultado para árvore vazia e folha antes de ordenar blocos.","explanation":"Recursão em árvore combina caso base, chamadas menores e composição de resultados.","conceptSteps":["Recursão em árvore combina caso base, chamadas menores e composição de resultados.","O mesmo padrão se aplica a diretórios, categorias e comentários hierárquicos."],"vocabulary":[],"workedExample":{"steps":["Para contar documentos, pasta ausente contribui zero; pasta existente soma seu documento e as contagens das subpastas.","Cada chamada desce até ausência."]},"notes":["Sem caso base, a chamada passa da folha; combinar antes de receber descendentes perde dados. Trate null primeiro.","O mesmo padrão se aplica a diretórios, categorias e comentários hierárquicos."],"docs":[],"materials":["Starter para o estudante: blocos: A=if(no===null)return 0; B=const esquerda=somar(no.esq); C=const direita=somar(no.dir); D=return no.valor+esquerda+direita (sem arquivo asset separado).","Entrada do exemplo público: árvore raiz 1, filhos 2 e 3."],"predictionGuide":"Preveja resultado para árvore vazia e folha antes de ordenar blocos. Primeiros 2 min de 20 min, antes de executar.","practiceSteps":["Use o starter descrito no contrato (blocos: A=if(no===null)return 0; B=const esquerda=somar(no.esq); C=const direita=somar(no.dir); D=return no.valor+esquerda+direita).","Ordene ou selecione os blocos, entregue a sequência final e explique uma dependência entre etapas."],"hints":["Releia o enunciado e separe entrada, saída e restrições: Use o starter descrito no contrato (blocos: A=if(no===null)return 0; B=const esquerda=somar(no.esq); C=const direita=somar(no.dir); D=return no.valor+esquerda+direita). Ordene ou selecione os blocos, entregue a sequência final e explique um","Compare com o exemplo público — dado: árvore raiz 1, filhos 2 e 3. Esperado: soma 6; ordem A antes de B/C antes de D.","Cuidado com a armadilha desta atividade: Sem caso base, a chamada passa da folha; combinar antes de receber descendentes perde dados."],"reflectionPrompt":"Compare sua primeira resposta com o resultado da tentativa. Explique a regra que você praticou e um erro que ela ajuda a evitar."},"hints":["Releia o enunciado e separe entrada, saída e restrições: Use o starter descrito no contrato (blocos: A=if(no===null)return 0; B=const esquerda=somar(no.esq); C=const direita=somar(no.dir); D=return no.valor+esquerda+direita). Ordene ou selecione os blocos, entregue a sequência final e explique um","Compare com o exemplo público — dado: árvore raiz 1, filhos 2 e 3. Esperado: soma 6; ordem A antes de B/C antes de D.","Cuidado com a armadilha desta atividade: Sem caso base, a chamada passa da folha; combinar antes de receber descendentes perde dados."]},"assessment":{"version":1,"checks":["behavior"],"environment":"javascript","testPath":"__devpath_tests__.js","referenceDir":"solutions/08.02","assertionCases":[{"id":"08.02.soma-os-valores-de-uma-arvor-ce426836","sourceTestPath":"tests/08.02.test.js","testName":"soma os valores de uma árvore binária e aceita ramo ausente","inputExpression":"somar({valor: 2, esq: {valor: 3}, dir: {valor: 5, esq: {valor: 7}}})","matcher":"toBe","expectedExpression":"17","negated":false,"initialArrangementExpression":"sem setup anterior dentro deste teste","assertionExpression":"expect(somar({valor: 2, esq: {valor: 3}, dir: {valor: 5, esq: {valor: 7}}})).toBe(17)","contractRule":"somar({valor: 2, esq: {valor: 3}, dir: {valor: 5, esq: {valor: 7}}}) toBe 17","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(somar({valor: 2, esq: {valor: 3}, dir: {valor: 5, esq: {valor: 7}}})).toBe(17)","assertionOffset":165,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"08.02.soma-os-valores-de-uma-arvor-bf3b14c9","sourceTestPath":"tests/08.02.test.js","testName":"soma os valores de uma árvore binária e aceita ramo ausente","inputExpression":"somar(null)","matcher":"toBe","expectedExpression":"0","negated":false,"initialArrangementExpression":"expect(somar({valor: 2, esq: {valor: 3}, dir: {valor: 5, esq: {valor: 7}}})).toBe(17);","assertionExpression":"expect(somar(null)).toBe(0)","contractRule":"somar(null) toBe 0","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(somar(null)).toBe(0)","assertionOffset":307,"assertionApi":"expect","executionScope":"browser-behavior-suite"}],"sourceTestPath":"tests/08.02.test.js","tests":"import {somar} from './main.js';\n\ntest('soma os valores de uma árvore binária e aceita ramo ausente', () => {\n  /*@case 08.02.soma-os-valores-de-uma-arvor-ce426836*/expect(somar({valor: 2, esq: {valor: 3}, dir: {valor: 5, esq: {valor: 7}}})).toBe(17);\n  /*@case 08.02.soma-os-valores-de-uma-arvor-bf3b14c9*/expect(somar(null)).toBe(0);\n});\n"},"reference":[{"path":"main.js","content":"export function somar(no) {\n  if (no === null || no === undefined) return 0;\n  const esquerda = somar(no.esq ?? null);\n  const direita = somar(no.dir ?? null);\n  return no.valor + esquerda + direita;\n}\n\nconsole.log(somar({valor: 2, esq: {valor: 3}, dir: {valor: 5}}));\n"}]},{"item":{"id":"08.07","title":"Trace BFS por largura","stage":"08","kind":"TRACE","contentVersion":2,"optional":false,"duration":"20 min","runtime":"Node.js 24 LTS · ECMAScript 2026 · módulos ES","compatibility":"Node.js 24 LTS (ES modules); Map, Set e arrays padrão, sem dependências externas.","objective":"Escreva a ordem de remoção da fila e o predecessor de cada vértice antes de reconstruir a rota.","prompt":"Antes de implementar a rota completa em 08.08, acompanhe uma busca em largura: registre fila, visitados e predecessor em cada passo e reconstrua o caminho de A até D.","firstResponse":{"action":"Escreva a ordem de remoção da fila e o predecessor de cada vértice antes de reconstruir a rota.","timing":"Depois de ler o grafo e antes de conferir a tabela de passos."},"explanation":{"mental_model":"Busca em largura mantém uma fila FIFO, registra o predecessor ao descobrir cada vértice e só então enfileira seus vizinhos não visitados.","worked_example":"De A, enfileire B e C. Retire B e descubra D; como C já está na fila, D fica depois dela. Ao retirar C, D já está visitado. O predecessor de D continua B e a reconstrução retorna A,B,D.","common_trap":"Marcar só ao retirar permite enfileirar D duas vezes. Trocar FIFO por pilha muda a exploração para profundidade e não garante a mesma rota mínima.","why_it_matters":"Rastrear fila e predecessores torna visível por que BFS encontra a rota com menos arestas antes de pedir ao aluno que implemente o planejador completo."},"interaction":"Tabela textual por passo com vértice removido, fila restante, visitados e predecessores; campos navegáveis por teclado e sem distinção baseada só em cor.","resources":["Starter visível no cartão: Map de adjacência para A→B,C; B→D; C→D; D sem vizinhos.","Tabela de passos com a fila FIFO, o conjunto de visitados e o predecessor de cada descoberta."],"starterFiles":[{"path":"main.js","content":"export function tracarBfs(grafo, inicio, destino) {\n  const fila = [inicio];\n  const visitados = new Set([inicio]);\n  const anterior = new Map();\n  const ordem = [];\n  while (fila.length) {\n    const atual = fila.shift();\n    ordem.push(atual);\n    if (atual === destino) break;\n    for (const vizinho of grafo.get(atual) ?? []) {\n      if (visitados.has(vizinho)) continue;\n      visitados.add(vizinho);\n      anterior.set(vizinho, atual);\n      fila.push(vizinho);\n    }\n  }\n  const caminho = [];\n  for (let no = destino; no !== undefined; no = anterior.get(no)) caminho.unshift(no);\n  return {ordem, caminho: caminho[0] === inicio ? caminho : []};\n}\n\nconst grafo = new Map([[\"A\", [\"B\", \"C\"]], [\"B\", [\"D\"]], [\"C\", [\"D\"]], [\"D\", []]]);\nconsole.log(JSON.stringify(tracarBfs(grafo, \"A\", \"D\")));\n"}],"assets":[],"examples":[{"given":"início A, destino D","expected":"removidos da fila A,B,C,D; fila após cada remoção [],[B,C],[C,D],[D],[]; anterior B<-A, C<-A, D<-B; caminho mínimo [A,B,D]"}],"checks":[{"fixture":{"given":"início A, destino D","expected":"removidos da fila A,B,C,D; fila após cada remoção [],[B,C],[C,D],[D],[]; anterior B<-A, C<-A, D<-B; caminho mínimo [A,B,D]"},"scoring":"Compare estados e ordem; peça explicação curta sobre a primeira divergência."}],"constraints":[],"rubric":[],"learningMetadata":{"requires":["03.01","05.01","07.05"]},"edgeCases":["início igual ao destino -> caminho [A]; destino X ausente ou inalcançável -> null; grafo com ciclo A<->B -> cada vértice entra na fila no máximo uma vez"],"review":{"prompt":"Por que a busca deve marcar um vértice ao enfileirá-lo?","choices":["Para impedir que ciclos ou vizinhos convergentes sejam enfileirados várias vezes.","Para ordenar os vértices alfabeticamente antes da busca.","Para transformar um grafo sem pesos em grafo ponderado.","Para visitar o destino antes de processar qualquer vizinho."],"answer":3,"correctFeedback":"Correto. Registrar na descoberta garante que cada vértice entre uma vez na fila.","incorrectFeedback":"A descoberta ocorre antes da remoção posterior. Marcar nesse momento evita duplicação em ciclos e caminhos convergentes."},"assessmentEnvironment":"javascript","autoTested":true,"preparation":{"guided":true,"stageTitle":"COMPLEXIDADE E RECURSÃO","introduction":"Escreva a ordem de remoção da fila e o predecessor de cada vértice antes de reconstruir a rota.","explanation":"Busca em largura mantém uma fila FIFO, registra o predecessor ao descobrir cada vértice e só então enfileira seus vizinhos não visitados.","conceptSteps":["Busca em largura mantém uma fila FIFO, registra o predecessor ao descobrir cada vértice e só então enfileira seus vizinhos não visitados.","Rastrear fila e predecessores torna visível por que BFS encontra a rota com menos arestas antes de pedir ao aluno que implemente o planejador completo."],"vocabulary":[],"workedExample":{"steps":["De A, enfileire B e C.","Retire B e descubra D; como C já está na fila, D fica depois dela.","Ao retirar C, D já está visitado.","O predecessor de D continua B e a reconstrução retorna A,B,D."]},"notes":["Marcar só ao retirar permite enfileirar D duas vezes. Trocar FIFO por pilha muda a exploração para profundidade e não garante a mesma rota mínima.","Rastrear fila e predecessores torna visível por que BFS encontra a rota com menos arestas antes de pedir ao aluno que implemente o planejador completo."],"docs":[],"materials":["Starter visível no cartão: Map de adjacência para A→B,C; B→D; C→D; D sem vizinhos.","Tabela de passos com a fila FIFO, o conjunto de visitados e o predecessor de cada descoberta."],"predictionGuide":"Escreva a ordem de remoção da fila e o predecessor de cada vértice antes de reconstruir a rota. Depois de ler o grafo e antes de conferir a tabela de passos.","practiceSteps":["Antes de implementar a rota completa em 08.08, acompanhe uma busca em largura: registre fila, visitados e predecessor em cada passo e reconstrua o caminho de A até D."],"hints":["Releia o enunciado e separe entrada, saída e restrições: Antes de implementar a rota completa em 08.08, acompanhe uma busca em largura: registre fila, visitados e predecessor em cada passo e reconstrua o caminho de A até D.","Compare com o exemplo público — dado: início A, destino D. Esperado: removidos da fila A,B,C,D; fila após cada remoção [],[B,C],[C,D],[D],[]; anterior B<-A, C<-A, D<-B; caminho mínimo [A,B,D].","Cuidado com a armadilha desta atividade: Marcar só ao retirar permite enfileirar D duas vezes."],"reflectionPrompt":"Compare sua primeira resposta com o resultado da tentativa. Explique a regra que você praticou e um erro que ela ajuda a evitar."},"hints":["Releia o enunciado e separe entrada, saída e restrições: Antes de implementar a rota completa em 08.08, acompanhe uma busca em largura: registre fila, visitados e predecessor em cada passo e reconstrua o caminho de A até D.","Compare com o exemplo público — dado: início A, destino D. Esperado: removidos da fila A,B,C,D; fila após cada remoção [],[B,C],[C,D],[D],[]; anterior B<-A, C<-A, D<-B; caminho mínimo [A,B,D].","Cuidado com a armadilha desta atividade: Marcar só ao retirar permite enfileirar D duas vezes."]},"assessment":{"version":1,"checks":["behavior"],"environment":"javascript","testPath":"__devpath_tests__.js","referenceDir":"solutions/08.07","predictionTable":{"version":1,"instructions":"Preencha cada valor antes de executar. Após a execução, compare cada resposta com o valor observado; respostas livres não recebem nota automática.","fields":[{"id":"ordem","label":"Ordem de visita"},{"id":"caminho","label":"Primeiro caminho até D"}]},"assertionCases":[{"id":"08.07.bfs-usa-fifo-marca-a-descobe-59878d56","sourceTestPath":"tests/08.07.test.js","testName":"BFS usa FIFO, marca a descoberta e reconstrói o primeiro caminho até D","inputExpression":"tracarBfs(grafo, 'A', 'D')","matcher":"toEqual","expectedExpression":"{ordem: ['A', 'B', 'C', 'D'], caminho: ['A', 'B', 'D']}","negated":false,"initialArrangementExpression":"const grafo = new Map([['A', ['B', 'C']], ['B', ['D']], ['C', ['D']], ['D', []]]);","assertionExpression":"expect(tracarBfs(grafo, 'A', 'D')).toEqual({ordem: ['A', 'B', 'C', 'D'], caminho: ['A', 'B', 'D']})","contractRule":"tracarBfs(grafo, 'A', 'D') toEqual {ordem: ['A', 'B', 'C', 'D'], caminho: ['A', 'B', 'D']}","investigation":"Confira a expressão de entrada e a comparação toEqual deste caso: expect(tracarBfs(grafo, 'A', 'D')).toEqual({ordem: ['A', 'B', 'C', 'D'], caminho: ['A', 'B', 'D']})","assertionOffset":265,"assertionApi":"expect","executionScope":"browser-behavior-suite"}],"sourceTestPath":"tests/08.07.test.js","tests":"import {tracarBfs} from './main.js';\n\ntest('BFS usa FIFO, marca a descoberta e reconstrói o primeiro caminho até D', () => {\n  const grafo = new Map([['A', ['B', 'C']], ['B', ['D']], ['C', ['D']], ['D', []]]);\n  /*@case 08.07.bfs-usa-fifo-marca-a-descobe-59878d56*/expect(tracarBfs(grafo, 'A', 'D')).toEqual({ordem: ['A', 'B', 'C', 'D'], caminho: ['A', 'B', 'D']});\n});\n"},"reference":[{"path":"main.js","content":"export function tracarBfs(grafo, inicio, destino) {\n  const fila = [inicio];\n  const visitados = new Set([inicio]);\n  const anterior = new Map();\n  const ordem = [];\n  while (fila.length) {\n    const atual = fila.shift();\n    ordem.push(atual);\n    if (atual === destino) break;\n    for (const vizinho of grafo.get(atual) ?? []) {\n      if (visitados.has(vizinho)) continue;\n      visitados.add(vizinho);\n      anterior.set(vizinho, atual);\n      fila.push(vizinho);\n    }\n  }\n  const caminho = [];\n  for (let no = destino; no !== undefined; no = anterior.get(no)) caminho.unshift(no);\n  return {ordem, caminho: caminho[0] === inicio ? caminho : []};\n}\n\nconst grafo = new Map([[\"A\", [\"B\", \"C\"]], [\"B\", [\"D\"]], [\"C\", [\"D\"]], [\"D\", []]]);\nconsole.log(JSON.stringify(tracarBfs(grafo, \"A\", \"D\")));\n"}],"prediction":{"ordem":"[\"A\",\"B\",\"C\",\"D\"]","caminho":"[\"A\",\"B\",\"D\"]"}},{"item":{"id":"09.01","title":"Mapa de escopo","stage":"09","kind":"TRACE","contentVersion":2,"optional":false,"duration":"17 min","runtime":"Node.js 24 LTS · ECMAScript 2026 · módulos ES","compatibility":"Node.js 24 LTS with ESM unless the card explicitly compares another context; use built-ins only and retain the contract’s stated fallback for newer APIs.","objective":"Desenhe caixas com os bindings declarados e classifique as referências do snippet antes de rodar.","prompt":"Leia o snippet no editor e desenhe uma caixa para cada bloco. Antes de executar, classifique onde cada nome nasce e marque em cada posição se a referência encontra um binding ao subir pela cadeia léxica. Depois rode o snippet e anote evidências. Entregue o mapa de escopos e explique por que chamar a função depois não muda onde foi declarada.","firstResponse":{"action":"Desenhe caixas com os bindings declarados e classifique as referências do snippet antes de rodar.","timing":"Nos primeiros 3 minutos, antes de executar ou consultar feedback."},"explanation":{"mental_model":"Escopo léxico depende do lugar em que uma função ou variável foi escrita. Para resolver um nome, procure no bloco atual e suba pelos blocos que o contêm; a ordem das chamadas não reescreve essa cadeia.","worked_example":"Em `const taxa=2; function total(){ const parcial=3; return taxa+parcial }`, marque `taxa` no bloco externo e `parcial` no corpo de `total`. A avaliação encontra `parcial` localmente e sobe um nível para encontrar `taxa`. Uma função irmã não recebe acesso a `parcial` só por ser chamada depois.","common_trap":"Não confunda estar disponível no momento da chamada com estar no escopo léxico. Desenhe os blocos de declaração e siga apenas ligações de contenção.","why_it_matters":"A regra permite inspecionar callbacks e funções aninhadas. Um mapa prévio ajuda a localizar referências inválidas sem tentativa e erro."},"interaction":"Mapa textual de blocos e tabela de posições de acesso; células editáveis via teclado e versão linear que anuncia bloco, nome e posição para leitor de tela.","resources":["Starter do exercício incluído no cartão: snippet: const fora=1; {let bloco=2; function f(){const dentro=3; return fora+bloco+dentro}}; fora/bloco/dentro/f em quatro posições","Documentação oficial indicada: MDN Closures: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Closures ; MDN let: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Statements/let"],"starterFiles":[{"path":"main.js","content":"export function tracarEscopo() {\n  const fora = 1;\n  let bloco;\n  let dentro;\n  {\n    bloco = 2;\n    function f() {\n      dentro = 3;\n      return fora + bloco + dentro;\n    }\n    f();\n  }\n  return {fora, bloco, dentro, soma: fora + bloco + dentro};\n}\n\nconsole.log(JSON.stringify(tracarEscopo()));\n"}],"assets":[],"examples":[{"given":"f() dentro do bloco","expected":"6; fora fora do bloco -> 1; bloco fora -> ReferenceError"}],"checks":[{"fixture":{"given":"f() dentro do bloco","expected":"6; fora fora do bloco -> 1; bloco fora -> ReferenceError"},"scoring":"Compare estados e ordem; peça explicação curta sobre a primeira divergência."}],"constraints":[],"rubric":[],"learningMetadata":{"requires":["04.01"]},"edgeCases":["dentro fora de f -> ReferenceError; função aninhada lê binding ancestral, não irmão"],"review":{"prompt":"Qual afirmação descreve o alcance de `let` e `const` em relação a `var`?","choices":["`let`, `const` e `var` têm todos escopo de bloco.","`let` e `const` têm escopo de bloco; `var` tem escopo de função.","`var` tem escopo de módulo, enquanto `let` e `const` são sempre globais."],"answer":1,"correctFeedback":"As declarações léxicas respeitam blocos; `var` é delimitado pela função mais próxima.","incorrectFeedback":"A diferença aparece ao comparar blocos internos com o escopo de função; as três declarações não têm o mesmo alcance."},"stageBridge":"Exemplo resolvido A: `function make(){let n=0;return ()=>++n}` devolve uma função que ainda acessa o binding `n` depois do retorno de `make`. Duas chamadas a `make()` criam bindings independentes. Exemplo resolvido B: uma factory retorna `inc` e `read`; ambas leem o mesmo `n`, então `read` observa o novo valor após `inc`. A função conserva acesso ao binding, não uma fotografia do valor inicial. Exemplo parcialmente resolvido: forneça a factory e retire a implementação de `reset`, pedindo previsão antes de editar. Exemplo independente: criar um store com `subscribe` e `unsubscribe`. Se o aluno errar captura em loop, compare `var` compartilhado com `let` por iteração e agende transferência em domínio diferente, como handlers de linhas de tabela.","stageBridgeTitle":"Closure com ajuda decrescente","assessmentEnvironment":"javascript","autoTested":true,"preparation":{"guided":true,"stageTitle":"ESCOPO E CLOSURES","introduction":"Desenhe caixas com os bindings declarados e classifique as referências do snippet antes de rodar.","explanation":"Escopo léxico depende do lugar em que uma função ou variável foi escrita. Para resolver um nome, procure no bloco atual e suba pelos blocos que o contêm; a ordem das chamadas não reescreve essa cadeia.","conceptSteps":["Escopo léxico depende do lugar em que uma função ou variável foi escrita.","Para resolver um nome, procure no bloco atual e suba pelos blocos que o contêm; a ordem das chamadas não reescreve essa cadeia.","A regra permite inspecionar callbacks e funções aninhadas."],"vocabulary":["`taxa` — Em `const taxa=2; function total(){ const parcial=3; return taxa+parcial }`, marque `taxa` no bloco externo e `parcial` no corpo de `total`.","`parcial` — Em `const taxa=2; function total(){ const parcial=3; return taxa+parcial }`, marque `taxa` no bloco externo e `parcial` no corpo de `total`."],"workedExample":{"steps":["Em `const taxa=2; function total(){ const parcial=3; return taxa+parcial }`, marque `taxa` no bloco externo e `parcial` no corpo de `total`.","A avaliação encontra `parcial` localmente e sobe um nível para encontrar `taxa`.","Uma função irmã não recebe acesso a `parcial` só por ser chamada depois."]},"notes":["Não confunda estar disponível no momento da chamada com estar no escopo léxico. Desenhe os blocos de declaração e siga apenas ligações de contenção.","A regra permite inspecionar callbacks e funções aninhadas. Um mapa prévio ajuda a localizar referências inválidas sem tentativa e erro."],"docs":[{"title":"Documentação oficial indicada: MDN Closures","url":"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Closures","section":"; MDN let: https://developer","question":"mozilla.org/en-US/docs/Web/JavaScript/Reference/Statements/let"}],"materials":["Starter do exercício incluído no cartão: snippet: const fora=1; {let bloco=2; function f(){const dentro=3; return fora+bloco+dentro}}; fora/bloco/dentro/f em quatro posições"],"predictionGuide":"Desenhe caixas com os bindings declarados e classifique as referências do snippet antes de rodar. Nos primeiros 3 minutos, antes de executar ou consultar feedback.","practiceSteps":["Leia o snippet no editor e desenhe uma caixa para cada bloco.","Antes de executar, classifique onde cada nome nasce e marque em cada posição se a referência encontra um binding ao subir pela cadeia léxica.","Depois rode o snippet e anote evidências."],"hints":["Releia o enunciado e separe entrada, saída e restrições: Leia o snippet no editor e desenhe uma caixa para cada bloco. Antes de executar, classifique onde cada nome nasce e marque em cada posição se a referência encontra um binding ao subir pela cadeia léxica. Depois rode o snippet e anote evidên","Compare com o exemplo público — dado: f() dentro do bloco. Esperado: 6; fora fora do bloco -> 1; bloco fora -> ReferenceError.","Cuidado com a armadilha desta atividade: Não confunda estar disponível no momento da chamada com estar no escopo léxico."],"reflectionPrompt":"Compare sua primeira resposta com o resultado da tentativa. Explique a regra que você praticou e um erro que ela ajuda a evitar."},"hints":["Releia o enunciado e separe entrada, saída e restrições: Leia o snippet no editor e desenhe uma caixa para cada bloco. Antes de executar, classifique onde cada nome nasce e marque em cada posição se a referência encontra um binding ao subir pela cadeia léxica. Depois rode o snippet e anote evidên","Compare com o exemplo público — dado: f() dentro do bloco. Esperado: 6; fora fora do bloco -> 1; bloco fora -> ReferenceError.","Cuidado com a armadilha desta atividade: Não confunda estar disponível no momento da chamada com estar no escopo léxico."]},"assessment":{"version":1,"checks":["behavior"],"environment":"javascript","testPath":"__devpath_tests__.js","referenceDir":"solutions/09.01","predictionTable":{"version":1,"instructions":"Preencha cada valor antes de executar. Após a execução, compare cada resposta com o valor observado; respostas livres não recebem nota automática.","fields":[{"id":"fora","label":"fora"},{"id":"bloco","label":"bloco"},{"id":"dentro","label":"dentro"},{"id":"soma","label":"soma devolvida"}]},"assertionCases":[{"id":"09.01.closures-leem-os-bindings-vi-09d12e22","sourceTestPath":"tests/09.01.test.js","testName":"closures leem os bindings visíveis durante a execução","inputExpression":"tracarEscopo()","matcher":"toEqual","expectedExpression":"{fora: 1, bloco: 2, dentro: 3, soma: 6}","negated":false,"initialArrangementExpression":"sem setup anterior dentro deste teste","assertionExpression":"expect(tracarEscopo()).toEqual({fora: 1, bloco: 2, dentro: 3, soma: 6})","contractRule":"tracarEscopo() toEqual {fora: 1, bloco: 2, dentro: 3, soma: 6}","investigation":"Confira a expressão de entrada e a comparação toEqual deste caso: expect(tracarEscopo()).toEqual({fora: 1, bloco: 2, dentro: 3, soma: 6})","assertionOffset":166,"assertionApi":"expect","executionScope":"browser-behavior-suite"}],"sourceTestPath":"tests/09.01.test.js","tests":"import {tracarEscopo} from './main.js';\n\ntest('closures leem os bindings visíveis durante a execução', () => {\n  /*@case 09.01.closures-leem-os-bindings-vi-09d12e22*/expect(tracarEscopo()).toEqual({fora: 1, bloco: 2, dentro: 3, soma: 6});\n});\n"},"reference":[{"path":"main.js","content":"export function tracarEscopo() {\n  const fora = 1;\n  let bloco;\n  let dentro;\n  {\n    bloco = 2;\n    function f() {\n      dentro = 3;\n      return fora + bloco + dentro;\n    }\n    f();\n  }\n  return {fora, bloco, dentro, soma: fora + bloco + dentro};\n}\n\nconsole.log(JSON.stringify(tracarEscopo()));\n"}],"prediction":{"fora":"1","bloco":"2","dentro":"3","soma":"6"}},{"item":{"id":"09.02","title":"Parsons de factory","stage":"09","kind":"PARSONS","contentVersion":2,"optional":false,"duration":"24 min","runtime":"Node.js 24 LTS · ECMAScript 2026 · módulos ES","compatibility":"Node.js 24 LTS with ESM unless the card explicitly compares another context; use built-ins only and retain the contract’s stated fallback for newer APIs.","objective":"Antes de montar os blocos, anote onde o estado deve ser declarado e descreva um teste que detecte compartilhamento entre contas.","prompt":"Ordene os blocos do starter para completar `criarConta` e implemente os métodos. Antes de rodar, anote em que chamada nasce o saldo e o que deve acontecer quando duas contas forem criadas. Rode o exemplo e acrescente uma verificação de isolamento entre instâncias.","firstResponse":{"action":"Antes de montar os blocos, anote onde o estado deve ser declarado e descreva um teste que detecte compartilhamento entre contas.","timing":"Nos primeiros 2 minutos, antes da montagem e da execução."},"explanation":{"mental_model":"Uma factory executada cria um novo ambiente léxico. Métodos retornados conservam acesso ao estado local desse ambiente; outra execução cria outro ambiente.","worked_example":"Em `makeLabel(prefix)`, retorne `name => prefix + name`. Uma chamada produz função que lê seu próprio prefixo; outra chamada com valor distinto produz outro binding capturado.","common_trap":"Não declare estado mutável no escopo global se cada instância precisa dos próprios dados. Retorne métodos que fecham sobre o binding local.","why_it_matters":"Closures criam módulos pequenos com estado privado e API explícita. A regra mantém instâncias independentes sem armazenamento externo."},"interaction":"Parsons acessível: blocos com botões mover para cima/baixo e alternativa por menus ordenados; depois, campos editáveis para completar métodos. Leitor de tela anuncia posição e texto.","resources":["Starter do exercício incluído no cartão: blocos embaralhados: function criarConta(inicial), let saldo, return {depositar, consultar}, validação de depósito, chamadas","Documentação oficial indicada: MDN Closures: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Closures"],"starterFiles":[{"path":"main.js","content":"export function criarConta(inicial) {\n  let saldo = inicial;\n  return {\n    depositar(valor) {\n      if (!(valor >= 0)) return false;\n      saldo += valor;\n      return true;\n    },\n    consultar() {\n      return saldo;\n    },\n  };\n}\n\nconsole.log(criarConta(2).depositar(3));\n"}],"assets":[],"examples":[{"given":"conta=criarConta(5); depositar(2)","expected":"true; consultar -> 7; depositar(-1) -> false; consulta permanece 7"}],"checks":[{"fixture":{"given":"conta=criarConta(5); depositar(2)","expected":"true; consultar -> 7; depositar(-1) -> false; consulta permanece 7"},"scoring":"Avalie ordem/seleção de blocos e comportamento final; não exija ordem entre blocos independentes."}],"constraints":[],"rubric":[],"learningMetadata":{"requires":["04.01"]},"edgeCases":["duas contas criadas com 1 e 9 -> saldos independentes"],"review":{"prompt":"O que caracteriza uma closure em JavaScript?","choices":["Uma cópia serializada de todos os objetos visíveis no momento da chamada.","Uma função que só pode ser executada uma vez depois de retornar.","Uma função junto ao acesso que mantém ao ambiente léxico relevante."],"answer":2,"correctFeedback":"A closure continua podendo acessar bindings do ambiente em que foi criada.","incorrectFeedback":"Closure não é uma serialização nem limita a função a uma chamada; ela preserva acesso lexical."},"assessmentEnvironment":"javascript","autoTested":true,"preparation":{"guided":true,"stageTitle":"ESCOPO E CLOSURES","introduction":"Antes de montar os blocos, anote onde o estado deve ser declarado e descreva um teste que detecte compartilhamento entre contas.","explanation":"Uma factory executada cria um novo ambiente léxico. Métodos retornados conservam acesso ao estado local desse ambiente; outra execução cria outro ambiente.","conceptSteps":["Uma factory executada cria um novo ambiente léxico.","Métodos retornados conservam acesso ao estado local desse ambiente; outra execução cria outro ambiente.","Closures criam módulos pequenos com estado privado e API explícita."],"vocabulary":[],"workedExample":{"steps":["Em `makeLabel(prefix)`, retorne `name => prefix + name`.","Uma chamada produz função que lê seu próprio prefixo; outra chamada com valor distinto produz outro binding capturado."]},"notes":["Não declare estado mutável no escopo global se cada instância precisa dos próprios dados. Retorne métodos que fecham sobre o binding local.","Closures criam módulos pequenos com estado privado e API explícita. A regra mantém instâncias independentes sem armazenamento externo."],"docs":[{"title":"Documentação oficial indicada: MDN Closures","url":"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Closures","section":"","question":""}],"materials":["Starter do exercício incluído no cartão: blocos embaralhados: function criarConta(inicial), let saldo, return {depositar, consultar}, validação de depósito, chamadas"],"predictionGuide":"Antes de montar os blocos, anote onde o estado deve ser declarado e descreva um teste que detecte compartilhamento entre contas. Nos primeiros 2 minutos, antes da montagem e da execução.","practiceSteps":["Ordene os blocos do starter para completar `criarConta` e implemente os métodos.","Antes de rodar, anote em que chamada nasce o saldo e o que deve acontecer quando duas contas forem criadas.","Rode o exemplo e acrescente uma verificação de isolamento entre instâncias."],"hints":["Releia o enunciado e separe entrada, saída e restrições: Ordene os blocos do starter para completar `criarConta` e implemente os métodos. Antes de rodar, anote em que chamada nasce o saldo e o que deve acontecer quando duas contas forem criadas. Rode o exemplo e acrescente uma verificação de isol","Compare com o exemplo público — dado: conta=criarConta(5); depositar(2). Esperado: true; consultar -> 7; depositar(-1) -> false; consulta permanece 7.","Cuidado com a armadilha desta atividade: Não declare estado mutável no escopo global se cada instância precisa dos próprios dados."],"reflectionPrompt":"Compare sua primeira resposta com o resultado da tentativa. Explique a regra que você praticou e um erro que ela ajuda a evitar."},"hints":["Releia o enunciado e separe entrada, saída e restrições: Ordene os blocos do starter para completar `criarConta` e implemente os métodos. Antes de rodar, anote em que chamada nasce o saldo e o que deve acontecer quando duas contas forem criadas. Rode o exemplo e acrescente uma verificação de isol","Compare com o exemplo público — dado: conta=criarConta(5); depositar(2). Esperado: true; consultar -> 7; depositar(-1) -> false; consulta permanece 7.","Cuidado com a armadilha desta atividade: Não declare estado mutável no escopo global se cada instância precisa dos próprios dados."]},"assessment":{"version":1,"checks":["behavior"],"environment":"javascript","testPath":"__devpath_tests__.js","referenceDir":"solutions/09.02","assertionCases":[{"id":"09.02.factory-mantem-saldo-privado-f4aee307","sourceTestPath":"tests/09.02.test.js","testName":"factory mantém saldo privado por conta e retorna operações","inputExpression":"a.consultar()","matcher":"toBe","expectedExpression":"2","negated":false,"initialArrangementExpression":"const a = criarConta(2);\n  const b = criarConta(10);","assertionExpression":"expect(a.consultar()).toBe(2)","contractRule":"a.consultar() toBe 2","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(a.consultar()).toBe(2)","assertionOffset":224,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"09.02.factory-mantem-saldo-privado-ed6d0009","sourceTestPath":"tests/09.02.test.js","testName":"factory mantém saldo privado por conta e retorna operações","inputExpression":"a.depositar(3)","matcher":"toBe","expectedExpression":"true","negated":false,"initialArrangementExpression":"const a = criarConta(2);\n  const b = criarConta(10);\n  expect(a.consultar()).toBe(2);","assertionExpression":"expect(a.depositar(3)).toBe(true)","contractRule":"a.depositar(3) toBe true","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(a.depositar(3)).toBe(true)","assertionOffset":310,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"09.02.factory-mantem-saldo-privado-90b15d09","sourceTestPath":"tests/09.02.test.js","testName":"factory mantém saldo privado por conta e retorna operações","inputExpression":"a.consultar()","matcher":"toBe","expectedExpression":"5","negated":false,"initialArrangementExpression":"const a = criarConta(2);\n  const b = criarConta(10);\n  expect(a.consultar()).toBe(2);\n  expect(a.depositar(3)).toBe(true);","assertionExpression":"expect(a.consultar()).toBe(5)","contractRule":"a.consultar() toBe 5","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(a.consultar()).toBe(5)","assertionOffset":400,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"09.02.factory-mantem-saldo-privado-da1c6257","sourceTestPath":"tests/09.02.test.js","testName":"factory mantém saldo privado por conta e retorna operações","inputExpression":"b.consultar()","matcher":"toBe","expectedExpression":"10","negated":false,"initialArrangementExpression":"const a = criarConta(2);\n  const b = criarConta(10);\n  expect(a.consultar()).toBe(2);\n  expect(a.depositar(3)).toBe(true);\n  expect(a.consultar()).toBe(5);","assertionExpression":"expect(b.consultar()).toBe(10)","contractRule":"b.consultar() toBe 10","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(b.consultar()).toBe(10)","assertionOffset":486,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"09.02.deposito-invalido-nao-altera-24b42a81","sourceTestPath":"tests/09.02.test.js","testName":"depósito inválido não altera o saldo","inputExpression":"conta.depositar(0)","matcher":"toBe","expectedExpression":"false","negated":false,"initialArrangementExpression":"const conta = criarConta(2);","assertionExpression":"expect(conta.depositar(0)).toBe(false)","contractRule":"conta.depositar(0) toBe false","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(conta.depositar(0)).toBe(false)","assertionOffset":662,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"09.02.deposito-invalido-nao-altera-33b92d9f","sourceTestPath":"tests/09.02.test.js","testName":"depósito inválido não altera o saldo","inputExpression":"conta.depositar(-1)","matcher":"toBe","expectedExpression":"false","negated":false,"initialArrangementExpression":"const conta = criarConta(2);\n  expect(conta.depositar(0)).toBe(false);","assertionExpression":"expect(conta.depositar(-1)).toBe(false)","contractRule":"conta.depositar(-1) toBe false","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(conta.depositar(-1)).toBe(false)","assertionOffset":757,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"09.02.deposito-invalido-nao-altera-aaeb617f","sourceTestPath":"tests/09.02.test.js","testName":"depósito inválido não altera o saldo","inputExpression":"conta.consultar()","matcher":"toBe","expectedExpression":"2","negated":false,"initialArrangementExpression":"const conta = criarConta(2);\n  expect(conta.depositar(0)).toBe(false);\n  expect(conta.depositar(-1)).toBe(false);","assertionExpression":"expect(conta.consultar()).toBe(2)","contractRule":"conta.consultar() toBe 2","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(conta.consultar()).toBe(2)","assertionOffset":853,"assertionApi":"expect","executionScope":"browser-behavior-suite"}],"sourceTestPath":"tests/09.02.test.js","tests":"import {criarConta} from './main.js';\n\ntest('factory mantém saldo privado por conta e retorna operações', () => {\n  const a = criarConta(2);\n  const b = criarConta(10);\n  /*@case 09.02.factory-mantem-saldo-privado-f4aee307*/expect(a.consultar()).toBe(2);\n  /*@case 09.02.factory-mantem-saldo-privado-ed6d0009*/expect(a.depositar(3)).toBe(true);\n  /*@case 09.02.factory-mantem-saldo-privado-90b15d09*/expect(a.consultar()).toBe(5);\n  /*@case 09.02.factory-mantem-saldo-privado-da1c6257*/expect(b.consultar()).toBe(10);\n});\n\ntest('depósito inválido não altera o saldo', () => {\n  const conta = criarConta(2);\n  /*@case 09.02.deposito-invalido-nao-altera-24b42a81*/expect(conta.depositar(0)).toBe(false);\n  /*@case 09.02.deposito-invalido-nao-altera-33b92d9f*/expect(conta.depositar(-1)).toBe(false);\n  /*@case 09.02.deposito-invalido-nao-altera-aaeb617f*/expect(conta.consultar()).toBe(2);\n});\n"},"reference":[{"path":"main.js","content":"export function criarConta(inicial) {\n  let saldo = inicial;\n  return {\n    depositar(valor) {\n      if (!(valor > 0)) return false;\n      saldo += valor;\n      return true;\n    },\n    consultar() {\n      return saldo;\n    },\n  };\n}\n\nconsole.log(criarConta(2).depositar(3));\n"}]},{"item":{"id":"09.04","title":"Closure passo a passo","stage":"09","kind":"TRACE","contentVersion":2,"optional":false,"duration":"19 min","runtime":"Node.js 24 LTS · ECMAScript 2026 · módulos ES","compatibility":"Node.js 24 LTS with ESM unless the card explicitly compares another context; use built-ins only and retain the contract’s stated fallback for newer APIs.","objective":"Preencha uma tabela temporal com o valor do binding antes e depois de cada chamada, sem executar o programa.","prompt":"Trace o starter em uma linha do tempo. Anote o valor do binding antes e depois de cada método; então rode o programa. Explique se as funções guardam uma cópia antiga ou consultam o binding local compartilhado por aquela instância.","firstResponse":{"action":"Preencha uma tabela temporal com o valor do binding antes e depois de cada chamada, sem executar o programa.","timing":"Nos primeiros 2 minutos, antes de rodar ou alterar o starter."},"explanation":{"mental_model":"Uma closure conserva acesso a um binding, não necessariamente uma fotografia do valor. Se um método o modifica, outro método da mesma instância lê o valor atualizado.","worked_example":"`makeClock()` cria `let minute=0` e retorna `advance()` e `read()`. Após `advance`, `read` consulta o mesmo binding; não conserva a leitura existente quando foi criada. Outra execução tem binding próprio.","common_trap":"Não desenhe um binding para cada método retornado. Eles foram criados no mesmo ambiente; use uma linha do tempo.","why_it_matters":"Entender bindings mutáveis evita previsões erradas em contadores, listeners e estado encapsulado."},"interaction":"Linha do tempo editável com colunas valor antes, ação e valor depois; alternativa de lista numerada acessível por teclado e leitor de tela.","resources":["Starter do exercício incluído no cartão: make(): let n=0; return {inc(){n++}, read(){return n}}; const a=make(), b=make()","Documentação oficial indicada: MDN Closures: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Closures"],"starterFiles":[{"path":"main.js","content":"export function criarContadores() {\n  function make() {\n    let n = 0;\n    return {inc() {n++;}, read() {return n;}};\n  }\n  const a = make();\n  const b = make();\n  a.inc();\n  return {a: a.read(), b: b.read()};\n}\n\nconsole.log(JSON.stringify(criarContadores()));\n"}],"assets":[],"examples":[{"given":"a.read(),a.inc(),a.read(),b.read()","expected":"0,1,1,0"}],"checks":[{"fixture":{"given":"a.read(),a.inc(),a.read(),b.read()","expected":"0,1,1,0"},"scoring":"Compare estados e ordem; peça explicação curta sobre a primeira divergência."}],"constraints":[],"rubric":[],"learningMetadata":{"requires":["04.01"]},"edgeCases":["const r=a.read; r() -> 1 porque método não usa this; chamada posterior vê n atual"],"review":{"prompt":"Métodos de leitura e alteração fecham sobre a mesma variável local. Depois da alteração, o que a leitura consulta?","choices":["O valor atual do mesmo binding capturado no ambiente compartilhado.","Uma cópia imutável criada quando os métodos foram definidos.","A variável local mais recente de qualquer outra instância.","O valor do parâmetro da última chamada externa ao módulo."],"answer":0,"correctFeedback":"As closures compartilham acesso ao binding local; uma alteração nele é visível às outras.","incorrectFeedback":"Diferencie binding e valor lido em um instante. Métodos da mesma factory consultam o ambiente compartilhado."},"assessmentEnvironment":"javascript","autoTested":true,"preparation":{"guided":true,"stageTitle":"ESCOPO E CLOSURES","introduction":"Preencha uma tabela temporal com o valor do binding antes e depois de cada chamada, sem executar o programa.","explanation":"Uma closure conserva acesso a um binding, não necessariamente uma fotografia do valor. Se um método o modifica, outro método da mesma instância lê o valor atualizado.","conceptSteps":["Uma closure conserva acesso a um binding, não necessariamente uma fotografia do valor.","Se um método o modifica, outro método da mesma instância lê o valor atualizado.","Entender bindings mutáveis evita previsões erradas em contadores, listeners e estado encapsulado."],"vocabulary":["`makeClock()` — `makeClock()` cria `let minute=0` e retorna `advance()` e `read()`.","`advance()` — `makeClock()` cria `let minute=0` e retorna `advance()` e `read()`.","`read()` — `makeClock()` cria `let minute=0` e retorna `advance()` e `read()`.","`advance` — Após `advance`, `read` consulta o mesmo binding; não conserva a leitura existente quando foi criada.","`read` — Após `advance`, `read` consulta o mesmo binding; não conserva a leitura existente quando foi criada."],"workedExample":{"steps":["`makeClock()` cria `let minute=0` e retorna `advance()` e `read()`.","Após `advance`, `read` consulta o mesmo binding; não conserva a leitura existente quando foi criada.","Outra execução tem binding próprio."]},"notes":["Não desenhe um binding para cada método retornado. Eles foram criados no mesmo ambiente; use uma linha do tempo.","Entender bindings mutáveis evita previsões erradas em contadores, listeners e estado encapsulado."],"docs":[{"title":"Documentação oficial indicada: MDN Closures","url":"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Closures","section":"","question":""}],"materials":["Starter do exercício incluído no cartão: make(): let n=0; return {inc(){n++}, read(){return n}}; const a=make(), b=make()"],"predictionGuide":"Preencha uma tabela temporal com o valor do binding antes e depois de cada chamada, sem executar o programa. Nos primeiros 2 minutos, antes de rodar ou alterar o starter.","practiceSteps":["Trace o starter em uma linha do tempo.","Anote o valor do binding antes e depois de cada método; então rode o programa.","Explique se as funções guardam uma cópia antiga ou consultam o binding local compartilhado por aquela instância."],"hints":["Releia o enunciado e separe entrada, saída e restrições: Trace o starter em uma linha do tempo. Anote o valor do binding antes e depois de cada método; então rode o programa. Explique se as funções guardam uma cópia antiga ou consultam o binding local compartilhado por aquela instância.","Compare com o exemplo público — dado: a.read(),a.inc(),a.read(),b.read(). Esperado: 0,1,1,0.","Cuidado com a armadilha desta atividade: Não desenhe um binding para cada método retornado."],"reflectionPrompt":"Compare sua primeira resposta com o resultado da tentativa. Explique a regra que você praticou e um erro que ela ajuda a evitar."},"hints":["Releia o enunciado e separe entrada, saída e restrições: Trace o starter em uma linha do tempo. Anote o valor do binding antes e depois de cada método; então rode o programa. Explique se as funções guardam uma cópia antiga ou consultam o binding local compartilhado por aquela instância.","Compare com o exemplo público — dado: a.read(),a.inc(),a.read(),b.read(). Esperado: 0,1,1,0.","Cuidado com a armadilha desta atividade: Não desenhe um binding para cada método retornado."]},"assessment":{"version":1,"checks":["behavior"],"environment":"javascript","testPath":"__devpath_tests__.js","referenceDir":"solutions/09.04","predictionTable":{"version":1,"instructions":"Preencha cada valor antes de executar. Após a execução, compare cada resposta com o valor observado; respostas livres não recebem nota automática.","fields":[{"id":"a","label":"a.read()"},{"id":"b","label":"b.read()"}]},"assertionCases":[{"id":"09.04.cada-chamada-da-factory-cria-1c9845a5","sourceTestPath":"tests/09.04.test.js","testName":"cada chamada da factory cria seu próprio binding fechado","inputExpression":"criarContadores()","matcher":"toEqual","expectedExpression":"{a: 1, b: 0}","negated":false,"initialArrangementExpression":"sem setup anterior dentro deste teste","assertionExpression":"expect(criarContadores()).toEqual({a: 1, b: 0})","contractRule":"criarContadores() toEqual {a: 1, b: 0}","investigation":"Confira a expressão de entrada e a comparação toEqual deste caso: expect(criarContadores()).toEqual({a: 1, b: 0})","assertionOffset":172,"assertionApi":"expect","executionScope":"browser-behavior-suite"}],"sourceTestPath":"tests/09.04.test.js","tests":"import {criarContadores} from './main.js';\n\ntest('cada chamada da factory cria seu próprio binding fechado', () => {\n  /*@case 09.04.cada-chamada-da-factory-cria-1c9845a5*/expect(criarContadores()).toEqual({a: 1, b: 0});\n});\n"},"reference":[{"path":"main.js","content":"export function criarContadores() {\n  function make() {\n    let n = 0;\n    return {inc() {n++;}, read() {return n;}};\n  }\n  const a = make();\n  const b = make();\n  a.inc();\n  return {a: a.read(), b: b.read()};\n}\n\nconsole.log(JSON.stringify(criarContadores()));\n"}],"prediction":{"a":"1","b":"0"}},{"item":{"id":"09.05","title":"Bug no loop e callback","stage":"09","kind":"DEBUG","contentVersion":2,"optional":false,"duration":"22 min","runtime":"Node.js 24 LTS · ECMAScript 2026 · módulos ES","compatibility":"Node.js 24 LTS with ESM unless the card explicitly compares another context; use built-ins only and retain the contract’s stated fallback for newer APIs.","objective":"Antes de editar, escreva a saída prevista e desenhe quantos bindings do índice existem para os callbacks guardados.","prompt":"Investigue o starter antes de corrigir: escreva o resultado previsto para os callbacks e indique quando cada um executa. Faça a menor alteração que preserva quantidade e execução tardia. Rode testes e justifique o binding consultado por cada callback.","firstResponse":{"action":"Antes de editar, escreva a saída prevista e desenhe quantos bindings do índice existem para os callbacks guardados.","timing":"Nos primeiros 3 minutos, antes da correção."},"explanation":{"mental_model":"Callback lê os bindings de seu escopo quando executado. Se funções do loop compartilham um binding mutável, podem observar o valor final; um binding por iteração separa valores.","worked_example":"Imagine um loop percorrendo três nomes e criando funções `()=>nome`. Se o binding for atualizado pelo loop, funções guardadas e chamadas depois podem ler a última atribuição.","common_trap":"Não confunda criação do callback com leitura do valor. Inspecione quantos bindings existem e onde o callback os encontra.","why_it_matters":"Handlers de interface e tarefas assíncronas executam depois da configuração. Um teste tardio detecta erros que uma chamada imediata esconderia."},"interaction":"Editor com comandos separados para criar callbacks e executá-los depois; passo a passo e tabela índice/binding. Saídas textuais e controles rotulados para acessibilidade.","resources":["Starter do exercício incluído no cartão: bug: var handlers=[]; for(var i=0;i<3;i++) handlers.push(()=>i); corrigir sem alterar quantidade de callbacks","Documentação oficial indicada: MDN Closures: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Closures ; MDN let: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Statements/let ; MDN var: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Statements/var"],"starterFiles":[{"path":"main.js","content":"export function criarHandlers(limite) {\n  const handlers = [];\n  for (var i = 0; i < limite; i++) {\n    handlers.push(() => i);\n  }\n  return handlers;\n}\n\nconsole.log(JSON.stringify(criarHandlers(3).map(handler => handler())));\n"}],"assets":[],"examples":[{"given":"handlers.map(f=>f()) antes","expected":"[3,3,3]; com let i no for -> [0,1,2]"}],"checks":[{"fixture":{"given":"handlers.map(f=>f()) antes","expected":"[3,3,3]; com let i no for -> [0,1,2]"},"scoring":"Exija reprodução, causa, correção e regressão."}],"constraints":[],"rubric":[],"learningMetadata":{"requires":["04.01"]},"edgeCases":["quatro iterações -> [0,1,2,3]; callback executado depois do loop mantém valor da iteração"],"primers":["`var` é a forma antiga de declarar variáveis: vale para a função inteira, não para o bloco, e sua declaração é içada. Os callbacks deste loop executam depois e leem o mesmo binding `i`, que terminou em `3`; declarar `i` com `let` no `for` cria um binding por iteração. Em código novo, prefira `const` e `let`."],"review":{"prompt":"Por que um callback pode consultar um binding lexical associado à sua criação mesmo quando executado depois?","choices":["O mecanismo reexecuta automaticamente o bloco que declarou a função.","A função mantém acesso ao ambiente léxico capturado.","O valor é sempre copiado para uma variável global quando o callback é criado."],"answer":1,"correctFeedback":"Uma closure mantém acesso aos bindings capturados durante a vida da função.","incorrectFeedback":"Execução tardia não recria o bloco nem exige variável global; a função conserva acesso lexical."},"assessmentEnvironment":"javascript","autoTested":true,"preparation":{"guided":true,"stageTitle":"ESCOPO E CLOSURES","introduction":"Antes de editar, escreva a saída prevista e desenhe quantos bindings do índice existem para os callbacks guardados.","explanation":"Callback lê os bindings de seu escopo quando executado. Se funções do loop compartilham um binding mutável, podem observar o valor final; um binding por iteração separa valores.","conceptSteps":["Callback lê os bindings de seu escopo quando executado.","Se funções do loop compartilham um binding mutável, podem observar o valor final; um binding por iteração separa valores.","Handlers de interface e tarefas assíncronas executam depois da configuração."],"vocabulary":[],"workedExample":{"steps":["Imagine um loop percorrendo três nomes e criando funções `()=>nome`.","Se o binding for atualizado pelo loop, funções guardadas e chamadas depois podem ler a última atribuição."]},"notes":["Não confunda criação do callback com leitura do valor. Inspecione quantos bindings existem e onde o callback os encontra.","Handlers de interface e tarefas assíncronas executam depois da configuração. Um teste tardio detecta erros que uma chamada imediata esconderia."],"docs":[{"title":"Documentação oficial indicada: MDN Closures","url":"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Closures","section":"; MDN let: https://developer","question":"mozilla.org/en-US/docs/Web/JavaScript/Reference/Statements/let ; MDN var: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Statements/var"}],"materials":["Starter do exercício incluído no cartão: bug: var handlers=[]; for(var i=0;i<3;i++) handlers.push(()=>i); corrigir sem alterar quantidade de callbacks"],"predictionGuide":"Antes de editar, escreva a saída prevista e desenhe quantos bindings do índice existem para os callbacks guardados. Nos primeiros 3 minutos, antes da correção.","practiceSteps":["Investigue o starter antes de corrigir: escreva o resultado previsto para os callbacks e indique quando cada um executa.","Faça a menor alteração que preserva quantidade e execução tardia.","Rode testes e justifique o binding consultado por cada callback."],"hints":["Releia o enunciado e separe entrada, saída e restrições: Investigue o starter antes de corrigir: escreva o resultado previsto para os callbacks e indique quando cada um executa. Faça a menor alteração que preserva quantidade e execução tardia. Rode testes e justifique o binding consultado por cad","Compare com o exemplo público — dado: handlers.map(f=>f()) antes. Esperado: [3,3,3]; com let i no for -> [0,1,2].","Cuidado com a armadilha desta atividade: Não confunda criação do callback com leitura do valor."],"reflectionPrompt":"Compare sua primeira resposta com o resultado da tentativa. Explique a regra que você praticou e um erro que ela ajuda a evitar."},"hints":["Releia o enunciado e separe entrada, saída e restrições: Investigue o starter antes de corrigir: escreva o resultado previsto para os callbacks e indique quando cada um executa. Faça a menor alteração que preserva quantidade e execução tardia. Rode testes e justifique o binding consultado por cad","Compare com o exemplo público — dado: handlers.map(f=>f()) antes. Esperado: [3,3,3]; com let i no for -> [0,1,2].","Cuidado com a armadilha desta atividade: Não confunda criação do callback com leitura do valor."]},"assessment":{"version":1,"checks":["behavior"],"environment":"javascript","testPath":"__devpath_tests__.js","referenceDir":"solutions/09.05","assertionCases":[{"id":"09.05.callbacks-lembram-o-indice-d-34efb9f2","sourceTestPath":"tests/09.05.test.js","testName":"callbacks lembram o índice da própria iteração depois do loop","inputExpression":"handlers","matcher":"toHaveLength","expectedExpression":"3","negated":false,"initialArrangementExpression":"const handlers = criarHandlers(3);","assertionExpression":"expect(handlers).toHaveLength(3)","contractRule":"handlers toHaveLength 3","investigation":"Confira a expressão de entrada e a comparação toHaveLength deste caso: expect(handlers).toHaveLength(3)","assertionOffset":212,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"09.05.callbacks-lembram-o-indice-d-3a4c4aff","sourceTestPath":"tests/09.05.test.js","testName":"callbacks lembram o índice da própria iteração depois do loop","inputExpression":"handlers.map(handler => handler())","matcher":"toEqual","expectedExpression":"[0, 1, 2]","negated":false,"initialArrangementExpression":"const handlers = criarHandlers(3);\n  expect(handlers).toHaveLength(3);","assertionExpression":"expect(handlers.map(handler => handler())).toEqual([0, 1, 2])","contractRule":"handlers.map(handler => handler()) toEqual [0, 1, 2]","investigation":"Confira a expressão de entrada e a comparação toEqual deste caso: expect(handlers.map(handler => handler())).toEqual([0, 1, 2])","assertionOffset":301,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"09.05.a-quantidade-de-callbacks-ac-2611eafb","sourceTestPath":"tests/09.05.test.js","testName":"a quantidade de callbacks acompanha o limite informado","inputExpression":"criarHandlers(4).map(handler => handler())","matcher":"toEqual","expectedExpression":"[0, 1, 2, 3]","negated":false,"initialArrangementExpression":"sem setup anterior dentro deste teste","assertionExpression":"expect(criarHandlers(4).map(handler => handler())).toEqual([0, 1, 2, 3])","contractRule":"criarHandlers(4).map(handler => handler()) toEqual [0, 1, 2, 3]","investigation":"Confira a expressão de entrada e a comparação toEqual deste caso: expect(criarHandlers(4).map(handler => handler())).toEqual([0, 1, 2, 3])","assertionOffset":495,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"09.05.a-quantidade-de-callbacks-ac-93c33972","sourceTestPath":"tests/09.05.test.js","testName":"a quantidade de callbacks acompanha o limite informado","inputExpression":"criarHandlers(0)","matcher":"toEqual","expectedExpression":"[]","negated":false,"initialArrangementExpression":"expect(criarHandlers(4).map(handler => handler())).toEqual([0, 1, 2, 3]);","assertionExpression":"expect(criarHandlers(0)).toEqual([])","contractRule":"criarHandlers(0) toEqual []","investigation":"Confira a expressão de entrada e a comparação toEqual deste caso: expect(criarHandlers(0)).toEqual([])","assertionOffset":624,"assertionApi":"expect","executionScope":"browser-behavior-suite"}],"sourceTestPath":"tests/09.05.test.js","tests":"import {criarHandlers} from './main.js';\n\ntest('callbacks lembram o índice da própria iteração depois do loop', () => {\n  const handlers = criarHandlers(3);\n  /*@case 09.05.callbacks-lembram-o-indice-d-34efb9f2*/expect(handlers).toHaveLength(3);\n  /*@case 09.05.callbacks-lembram-o-indice-d-3a4c4aff*/expect(handlers.map(handler => handler())).toEqual([0, 1, 2]);\n});\n\ntest('a quantidade de callbacks acompanha o limite informado', () => {\n  /*@case 09.05.a-quantidade-de-callbacks-ac-2611eafb*/expect(criarHandlers(4).map(handler => handler())).toEqual([0, 1, 2, 3]);\n  /*@case 09.05.a-quantidade-de-callbacks-ac-93c33972*/expect(criarHandlers(0)).toEqual([]);\n});\n"},"reference":[{"path":"main.js","content":"export function criarHandlers(limite) {\n  const handlers = [];\n  for (let i = 0; i < limite; i++) {\n    handlers.push(() => i);\n  }\n  return handlers;\n}\n\nconsole.log(JSON.stringify(criarHandlers(3).map(handler => handler())));\n"}]},{"item":{"id":"10.01","title":"Preveja this - metodo comum vs arrow","stage":"10","kind":"PREDICT","contentVersion":2,"optional":false,"duration":"10 min","runtime":"Node.js 24 LTS · ECMAScript 2026 · módulos ES","compatibility":"Node.js 24 LTS with ESM unless the card explicitly compares another context; use built-ins only and retain the contract’s stated fallback for newer APIs.","objective":"Faça uma tabela com as formas de chamada do starter e escreva quem fornece `this` em cada uma, sem executar.","prompt":"Use o objeto do starter para comparar uma chamada por propriedade, uma chamada com `call` e a função separada. Antes de executar, anote quem fornece `this` em cada forma; depois confronte a previsão e explique por que a arrow não troca seu `this` pelo de `call`.","firstResponse":{"action":"Faça uma tabela com as formas de chamada do starter e escreva quem fornece `this` em cada uma, sem executar.","timing":"Nos primeiros 2 minutos, antes de executar ou corrigir."},"explanation":{"mental_model":"Em método comum, `this` vem da forma da chamada: `obj.m()` fornece `obj`; uma chamada solta não leva automaticamente o objeto original. Arrow não cria seu próprio `this`, então conserva o contexto léxico onde foi escrita.","worked_example":"Considere `const leitor={prefixo:\"A\", juntar(texto){return this.prefixo+texto}}`. `leitor.juntar.call({prefixo:\"B\"},\"!\")` fornece outro receptor à chamada do método comum. O resultado depende da chamada, não de onde o método foi armazenado. Uma arrow definida fora desse método não se tornaria ligada ao novo receptor só por usar `call`.","common_trap":"Não trate toda propriedade de função como método permanentemente ligado ao objeto. Observe o call site e distinga método comum de arrow.","why_it_matters":"Callbacks retirados de objetos são comuns em timers e listeners. Identificar o receptor evita erros de estado sem esconder a decisão em uma solução ad hoc."},"interaction":"Tabela textual para chamada, receptor e previsão; campos acessíveis por Tab e leitor de tela. O runner mostra a chamada executada em texto e deixa comparar com a previsão.","resources":["Starter do exercício incluído no cartão: obj={x:2,metodo(){return this.x},arrow:()=>this?.x}; const solto=obj.metodo","Documentação oficial indicada: MDN this: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Operators/this ; MDN arrow functions: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Functions/Arrow_functions"],"starterFiles":[{"path":"main.js","content":"const obj = {\n  x: 2,\n  metodo() {return this.x;},\n  arrow: () => this?.x,\n};\nconst solto = obj.metodo;\n\nexport function compararThis() {\n  let soltoResultado;\n  try { soltoResultado = solto(); }\n  catch (error) { soltoResultado = error.name; }\n  return {\n    metodo: obj.metodo(),\n    call: obj.metodo.call({x: 7}),\n    solto: soltoResultado,\n    arrowCall: String(obj.arrow.call({x: 7})),\n  };\n}\n\nconsole.log(JSON.stringify(compararThis()));\n"}],"assets":[],"examples":[{"given":"obj.metodo()","expected":"2; obj.metodo.call({x:7}) -> 7"}],"checks":[{"fixture":{"given":"obj.metodo()","expected":"2; obj.metodo.call({x:7}) -> 7"},"scoring":"Compare resposta registrada antes de Run com sequência/valor previstos; confiança é diagnóstica."}],"constraints":[],"rubric":[],"learningMetadata":{"requires":["06.01","04.01","06.11"]},"edgeCases":["solto() em módulo strict -> falha ao ler x porque não recebeu obj como this; arrow.call({x:7}) -> não devolve 7"],"primers":["`obj?.x` lê `x` só se `obj` não for `null` nem `undefined`; nesse caso o resultado é `undefined` em vez de um `TypeError`. `obj?.metodo()` chama o método só se `obj` existir."],"review":{"prompt":"O que determina o `this` de um método comum chamado como `obj.metodo()`?","choices":["O objeto em que a função foi escrita fica ligado para sempre.","A base à esquerda do ponto na chamada fornece o receptor.","O primeiro argumento declarado pelo método vira automaticamente o receptor.","O último objeto criado no mesmo módulo fornece o receptor."],"answer":1,"correctFeedback":"Em chamada por propriedade, a base da expressão é o receptor de `this`.","incorrectFeedback":"Separe a definição da função do call site. Método comum não fica permanentemente ligado ao objeto que o contém."},"stageBridge":"Exemplo resolvido A: `obj.metodo()` define o receptor pela forma da chamada; `const f=obj.metodo; f()` perde a base. Em módulo estrito, ler `this.x` nessa chamada solta pode lançar. Exemplo resolvido B: `obj.metodo.call(outro)` chama método comum com outro receptor, mas `.call` não substitui o `this` lexical de uma arrow. Exemplo parcialmente resolvido: o aluno recebe um callback extraído e escolhe `bind` ou wrapper `()=>obj.metodo()` explicando qual objeto será consultado no momento da execução. Só depois aparecem classes e protótipos. Classe é ferramenta para um contrato de instâncias, não prêmio por avançar no currículo; composição é preferível quando capacidades variam independentemente.","stageBridgeTitle":"this, método e arrow","assessmentEnvironment":"javascript","autoTested":true,"preparation":{"guided":true,"stageTitle":"THIS, PROTÓTIPOS E CLASSES","introduction":"Faça uma tabela com as formas de chamada do starter e escreva quem fornece `this` em cada uma, sem executar.","explanation":"Em método comum, `this` vem da forma da chamada: `obj.m()` fornece `obj`; uma chamada solta não leva automaticamente o objeto original. Arrow não cria seu próprio `this`, então conserva o contexto léxico onde foi escrita.","conceptSteps":["Em método comum, `this` vem da forma da chamada: `obj.m()` fornece `obj`; uma chamada solta não leva automaticamente o objeto original.","Arrow não cria seu próprio `this`, então conserva o contexto léxico onde foi escrita.","Callbacks retirados de objetos são comuns em timers e listeners."],"vocabulary":["`this` — Em método comum, `this` vem da forma da chamada: `obj.m()` fornece `obj`; uma chamada solta não leva automaticamente o objeto original.","`obj.m()` — Em método comum, `this` vem da forma da chamada: `obj.m()` fornece `obj`; uma chamada solta não leva automaticamente o objeto original.","`obj` — Em método comum, `this` vem da forma da chamada: `obj.m()` fornece `obj`; uma chamada solta não leva automaticamente o objeto original.","`call` — Uma arrow definida fora desse método não se tornaria ligada ao novo receptor só por usar `call`."],"workedExample":{"steps":["Considere `const leitor={prefixo:\"A\", juntar(texto){return this.prefixo+texto}}`.","`leitor.juntar.call({prefixo:\"B\"},\"!\")` fornece outro receptor à chamada do método comum.","O resultado depende da chamada, não de onde o método foi armazenado.","Uma arrow definida fora desse método não se tornaria ligada ao novo receptor só por usar `call`."]},"notes":["Não trate toda propriedade de função como método permanentemente ligado ao objeto. Observe o call site e distinga método comum de arrow.","Callbacks retirados de objetos são comuns em timers e listeners. Identificar o receptor evita erros de estado sem esconder a decisão em uma solução ad hoc."],"docs":[{"title":"Documentação oficial indicada: MDN this","url":"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Operators/this","section":"; MDN arrow functions: https://developer","question":"mozilla.org/en-US/docs/Web/JavaScript/Reference/Functions/Arrow_functions"}],"materials":["Starter do exercício incluído no cartão: obj={x:2,metodo(){return this.x},arrow:()=>this?.x}; const solto=obj.metodo"],"predictionGuide":"Faça uma tabela com as formas de chamada do starter e escreva quem fornece `this` em cada uma, sem executar. Nos primeiros 2 minutos, antes de executar ou corrigir.","practiceSteps":["Use o objeto do starter para comparar uma chamada por propriedade, uma chamada com `call` e a função separada.","Antes de executar, anote quem fornece `this` em cada forma; depois confronte a previsão e explique por que a arrow não troca seu `this` pelo de `call`."],"hints":["Releia o enunciado e separe entrada, saída e restrições: Use o objeto do starter para comparar uma chamada por propriedade, uma chamada com `call` e a função separada. Antes de executar, anote quem fornece `this` em cada forma; depois confronte a previsão e explique por que a arrow não troca seu ","Compare com o exemplo público — dado: obj.metodo(). Esperado: 2; obj.metodo.call({x:7}) -> 7.","Cuidado com a armadilha desta atividade: Não trate toda propriedade de função como método permanentemente ligado ao objeto."],"reflectionPrompt":"Compare sua primeira resposta com o resultado da tentativa. Explique a regra que você praticou e um erro que ela ajuda a evitar."},"hints":["Releia o enunciado e separe entrada, saída e restrições: Use o objeto do starter para comparar uma chamada por propriedade, uma chamada com `call` e a função separada. Antes de executar, anote quem fornece `this` em cada forma; depois confronte a previsão e explique por que a arrow não troca seu ","Compare com o exemplo público — dado: obj.metodo(). Esperado: 2; obj.metodo.call({x:7}) -> 7.","Cuidado com a armadilha desta atividade: Não trate toda propriedade de função como método permanentemente ligado ao objeto."]},"assessment":{"version":1,"checks":["behavior"],"environment":"javascript","testPath":"__devpath_tests__.js","referenceDir":"solutions/10.01","predictionTable":{"version":1,"instructions":"Preencha cada valor antes de executar. Após a execução, compare cada resposta com o valor observado; respostas livres não recebem nota automática.","fields":[{"id":"metodo","label":"obj.metodo()"},{"id":"call","label":"obj.metodo.call({x:7})"},{"id":"solto","label":"solto() em módulo ESM"},{"id":"arrowCall","label":"obj.arrow.call({x:7})"}]},"assertionCases":[{"id":"10.01.this-de-metodo-acompanha-o-c-24bd70c9","sourceTestPath":"tests/10.01.test.js","testName":"this de método acompanha o call site e arrow conserva o contexto léxico","inputExpression":"compararThis()","matcher":"toEqual","expectedExpression":"{metodo: 2, call: 7, solto: 'TypeError', arrowCall: 'undefined'}","negated":false,"initialArrangementExpression":"sem setup anterior dentro deste teste","assertionExpression":"expect(compararThis()).toEqual({metodo: 2, call: 7, solto: 'TypeError', arrowCall: 'undefined'})","contractRule":"compararThis() toEqual {metodo: 2, call: 7, solto: 'TypeError', arrowCall: 'undefined'}","investigation":"Confira a expressão de entrada e a comparação toEqual deste caso: expect(compararThis()).toEqual({metodo: 2, call: 7, solto: 'TypeError', arrowCall: 'undefined'})","assertionOffset":184,"assertionApi":"expect","executionScope":"browser-behavior-suite"}],"sourceTestPath":"tests/10.01.test.js","tests":"import {compararThis} from './main.js';\n\ntest('this de método acompanha o call site e arrow conserva o contexto léxico', () => {\n  /*@case 10.01.this-de-metodo-acompanha-o-c-24bd70c9*/expect(compararThis()).toEqual({metodo: 2, call: 7, solto: 'TypeError', arrowCall: 'undefined'});\n});\n"},"reference":[{"path":"main.js","content":"const obj = {\n  x: 2,\n  metodo() {return this.x;},\n  arrow: () => this?.x,\n};\nconst solto = obj.metodo;\n\nexport function compararThis() {\n  let soltoResultado;\n  try { soltoResultado = solto(); }\n  catch (error) { soltoResultado = error.name; }\n  return {\n    metodo: obj.metodo(),\n    call: obj.metodo.call({x: 7}),\n    solto: soltoResultado,\n    arrowCall: String(obj.arrow.call({x: 7})),\n  };\n}\n\nconsole.log(JSON.stringify(compararThis()));\n"}],"prediction":{"metodo":"2","call":"7","solto":"TypeError","arrowCall":"undefined"}},{"item":{"id":"10.02","title":"Parsons de classe","stage":"10","kind":"PARSONS","contentVersion":2,"optional":false,"duration":"10 min","runtime":"Node.js 24 LTS · ECMAScript 2026 · módulos ES","compatibility":"Node.js 24 LTS with ESM unless the card explicitly compares another context; use built-ins only and retain the contract’s stated fallback for newer APIs.","objective":"Marque nos blocos onde o campo privado nasce, onde muda e qual interface externa apenas o consulta.","prompt":"Ordene os blocos da classe e complete a implementação. Antes de executar, escreva onde o campo privado é inicializado e quais operações podem alterar saldo. Depois rode o cenário e acrescente um teste que proteja o invariante da classe.","firstResponse":{"action":"Marque nos blocos onde o campo privado nasce, onde muda e qual interface externa apenas o consulta.","timing":"Nos primeiros 2 minutos, antes de ordenar ou executar os blocos."},"explanation":{"mental_model":"Campos privados com `#` pertencem à instância da classe e só podem ser acessados no corpo autorizado. O constructor estabelece estado inicial; métodos públicos validam mudanças e um getter pode expor leitura sem liberar mutação direta.","worked_example":"Uma classe `Vagas` pode inicializar `#livres` no constructor, expor um getter e oferecer `reservar()`. A operação verifica a condição antes de diminuir o valor; código externo consulta a quantidade, mas não escreve diretamente no campo privado.","common_trap":"Não atribua o campo privado fora da classe nem permita que uma mutação viole o invariante. Faça a validação antes de alterar o estado.","why_it_matters":"Encapsular estado torna explícito quais operações são permitidas e protege invariantes locais sem precisar de arquitetura externa."},"interaction":"Parsons por botões de subir/descer ou lista acessível com ordem escolhida; depois editor para completar validação. Saída de erros e leituras aparece como texto.","resources":["Starter do exercício incluído no cartão: blocos de class Cofre {#saldo; constructor(inicial); depositar(valor); get saldo()} embaralhados","Documentação oficial indicada: MDN private elements: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Classes/Private_elements"],"starterFiles":[{"path":"main.js","content":"export class Cofre {\n  #saldo;\n\n  constructor(inicial) {\n    this.#saldo = inicial;\n  }\n\n  depositar(valor) {\n    if (!(valor > 0)) return false;\n    this.#saldo += valor;\n    return true;\n  }\n\n  get saldo() {\n    return this.#saldo;\n  }\n}\n\nconsole.log(new Cofre(2).saldo);\n"}],"assets":[],"examples":[{"given":"new Cofre(2).depositar(3); saldo","expected":"5"}],"checks":[{"fixture":{"given":"new Cofre(2).depositar(3); saldo","expected":"5"},"scoring":"Avalie ordem/seleção de blocos e comportamento final; não exija ordem entre blocos independentes."}],"constraints":[],"rubric":[],"learningMetadata":{"requires":["06.01","04.01"]},"edgeCases":["saldo inicial negativo -> saldo inicial 0; depósito zero/negativo -> retorna false e não altera o saldo; #saldo só pode ser acessado no corpo da classe"],"review":{"prompt":"Por que testes de encapsulamento devem preferir a API pública em vez de inspecionar diretamente um campo privado?","choices":["Porque um campo privado não pode participar de nenhum cálculo dentro da classe.","Porque testes só podem criar instâncias e nunca chamar métodos públicos.","Porque o contrato útil é o comportamento observável; detalhes privados podem mudar sem alterar a API."],"answer":2,"correctFeedback":"Testar pela interface protege o comportamento prometido e permite mudar a implementação interna.","incorrectFeedback":"Campos privados participam da implementação; o teste deve verificar efeitos públicos sem acoplar-se a eles."},"assessmentEnvironment":"javascript","autoTested":true,"preparation":{"guided":true,"stageTitle":"THIS, PROTÓTIPOS E CLASSES","introduction":"Marque nos blocos onde o campo privado nasce, onde muda e qual interface externa apenas o consulta.","explanation":"Campos privados com `#` pertencem à instância da classe e só podem ser acessados no corpo autorizado. O constructor estabelece estado inicial; métodos públicos validam mudanças e um getter pode expor leitura sem liberar mutação direta.","conceptSteps":["Campos privados com `#` pertencem à instância da classe e só podem ser acessados no corpo autorizado.","O constructor estabelece estado inicial; métodos públicos validam mudanças e um getter pode expor leitura sem liberar mutação direta.","Encapsular estado torna explícito quais operações são permitidas e protege invariantes locais sem precisar de arquitetura externa."],"vocabulary":["`Vagas` — Uma classe `Vagas` pode inicializar `#livres` no constructor, expor um getter e oferecer `reservar()`.","`reservar()` — Uma classe `Vagas` pode inicializar `#livres` no constructor, expor um getter e oferecer `reservar()`."],"workedExample":{"steps":["Uma classe `Vagas` pode inicializar `#livres` no constructor, expor um getter e oferecer `reservar()`.","A operação verifica a condição antes de diminuir o valor; código externo consulta a quantidade, mas não escreve diretamente no campo privado."]},"notes":["Não atribua o campo privado fora da classe nem permita que uma mutação viole o invariante. Faça a validação antes de alterar o estado.","Encapsular estado torna explícito quais operações são permitidas e protege invariantes locais sem precisar de arquitetura externa."],"docs":[{"title":"Documentação oficial indicada: MDN private elements","url":"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Classes/Private_elements","section":"","question":""}],"materials":["Starter do exercício incluído no cartão: blocos de class Cofre {#saldo; constructor(inicial); depositar(valor); get saldo()} embaralhados"],"predictionGuide":"Marque nos blocos onde o campo privado nasce, onde muda e qual interface externa apenas o consulta. Nos primeiros 2 minutos, antes de ordenar ou executar os blocos.","practiceSteps":["Ordene os blocos da classe e complete a implementação.","Antes de executar, escreva onde o campo privado é inicializado e quais operações podem alterar saldo.","Depois rode o cenário e acrescente um teste que proteja o invariante da classe."],"hints":["Releia o enunciado e separe entrada, saída e restrições: Ordene os blocos da classe e complete a implementação. Antes de executar, escreva onde o campo privado é inicializado e quais operações podem alterar saldo. Depois rode o cenário e acrescente um teste que proteja o invariante da classe.","Compare com o exemplo público — dado: new Cofre(2).depositar(3); saldo. Esperado: 5.","Cuidado com a armadilha desta atividade: Não atribua o campo privado fora da classe nem permita que uma mutação viole o invariante."],"reflectionPrompt":"Compare sua primeira resposta com o resultado da tentativa. Explique a regra que você praticou e um erro que ela ajuda a evitar."},"hints":["Releia o enunciado e separe entrada, saída e restrições: Ordene os blocos da classe e complete a implementação. Antes de executar, escreva onde o campo privado é inicializado e quais operações podem alterar saldo. Depois rode o cenário e acrescente um teste que proteja o invariante da classe.","Compare com o exemplo público — dado: new Cofre(2).depositar(3); saldo. Esperado: 5.","Cuidado com a armadilha desta atividade: Não atribua o campo privado fora da classe nem permita que uma mutação viole o invariante."]},"assessment":{"version":1,"checks":["behavior"],"environment":"javascript","testPath":"__devpath_tests__.js","referenceDir":"solutions/10.02","assertionCases":[{"id":"10.02.classe-mantem-saldo-encapsul-bdc170eb","sourceTestPath":"tests/10.02.test.js","testName":"classe mantém saldo encapsulado e expõe getter de leitura","inputExpression":"cofre.saldo","matcher":"toBe","expectedExpression":"2","negated":false,"initialArrangementExpression":"const cofre = new Cofre(2);","assertionExpression":"expect(cofre.saldo).toBe(2)","contractRule":"cofre.saldo toBe 2","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(cofre.saldo).toBe(2)","assertionOffset":193,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"10.02.classe-mantem-saldo-encapsul-57579c6f","sourceTestPath":"tests/10.02.test.js","testName":"classe mantém saldo encapsulado e expõe getter de leitura","inputExpression":"cofre.depositar(3)","matcher":"toBe","expectedExpression":"true","negated":false,"initialArrangementExpression":"const cofre = new Cofre(2);\n  expect(cofre.saldo).toBe(2);","assertionExpression":"expect(cofre.depositar(3)).toBe(true)","contractRule":"cofre.depositar(3) toBe true","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(cofre.depositar(3)).toBe(true)","assertionOffset":277,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"10.02.classe-mantem-saldo-encapsul-4588a6cd","sourceTestPath":"tests/10.02.test.js","testName":"classe mantém saldo encapsulado e expõe getter de leitura","inputExpression":"cofre.saldo","matcher":"toBe","expectedExpression":"5","negated":false,"initialArrangementExpression":"const cofre = new Cofre(2);\n  expect(cofre.saldo).toBe(2);\n  expect(cofre.depositar(3)).toBe(true);","assertionExpression":"expect(cofre.saldo).toBe(5)","contractRule":"cofre.saldo toBe 5","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(cofre.saldo).toBe(5)","assertionOffset":371,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"10.02.classe-mantem-saldo-encapsul-29c8909e","sourceTestPath":"tests/10.02.test.js","testName":"classe mantém saldo encapsulado e expõe getter de leitura","inputExpression":"'#saldo' in cofre","matcher":"toBe","expectedExpression":"false","negated":false,"initialArrangementExpression":"const cofre = new Cofre(2);\n  expect(cofre.saldo).toBe(2);\n  expect(cofre.depositar(3)).toBe(true);\n  expect(cofre.saldo).toBe(5);","assertionExpression":"expect('#saldo' in cofre).toBe(false)","contractRule":"'#saldo' in cofre toBe false","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect('#saldo' in cofre).toBe(false)","assertionOffset":455,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"10.02.saldo-nunca-fica-negativo-po-4ce62a78","sourceTestPath":"tests/10.02.test.js","testName":"saldo nunca fica negativo por construção ou depósito inválido","inputExpression":"cofre.saldo","matcher":"toBe","expectedExpression":"0","negated":false,"initialArrangementExpression":"const cofre = new Cofre(-4);","assertionExpression":"expect(cofre.saldo).toBe(0)","contractRule":"cofre.saldo toBe 0","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(cofre.saldo).toBe(0)","assertionOffset":663,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"10.02.saldo-nunca-fica-negativo-po-b1386e8d","sourceTestPath":"tests/10.02.test.js","testName":"saldo nunca fica negativo por construção ou depósito inválido","inputExpression":"cofre.depositar(0)","matcher":"toBe","expectedExpression":"false","negated":false,"initialArrangementExpression":"const cofre = new Cofre(-4);\n  expect(cofre.saldo).toBe(0);","assertionExpression":"expect(cofre.depositar(0)).toBe(false)","contractRule":"cofre.depositar(0) toBe false","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(cofre.depositar(0)).toBe(false)","assertionOffset":747,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"10.02.saldo-nunca-fica-negativo-po-ff473c17","sourceTestPath":"tests/10.02.test.js","testName":"saldo nunca fica negativo por construção ou depósito inválido","inputExpression":"cofre.depositar(-2)","matcher":"toBe","expectedExpression":"false","negated":false,"initialArrangementExpression":"const cofre = new Cofre(-4);\n  expect(cofre.saldo).toBe(0);\n  expect(cofre.depositar(0)).toBe(false);","assertionExpression":"expect(cofre.depositar(-2)).toBe(false)","contractRule":"cofre.depositar(-2) toBe false","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(cofre.depositar(-2)).toBe(false)","assertionOffset":842,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"10.02.saldo-nunca-fica-negativo-po-4ce62a78","sourceTestPath":"tests/10.02.test.js","testName":"saldo nunca fica negativo por construção ou depósito inválido","inputExpression":"cofre.saldo","matcher":"toBe","expectedExpression":"0","negated":false,"initialArrangementExpression":"const cofre = new Cofre(-4);\n  expect(cofre.saldo).toBe(0);\n  expect(cofre.depositar(0)).toBe(false);\n  expect(cofre.depositar(-2)).toBe(false);","assertionExpression":"expect(cofre.saldo).toBe(0)","contractRule":"cofre.saldo toBe 0","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(cofre.saldo).toBe(0)","assertionOffset":938,"assertionApi":"expect","executionScope":"browser-behavior-suite"}],"sourceTestPath":"tests/10.02.test.js","tests":"import {Cofre} from './main.js';\n\ntest('classe mantém saldo encapsulado e expõe getter de leitura', () => {\n  const cofre = new Cofre(2);\n  /*@case 10.02.classe-mantem-saldo-encapsul-bdc170eb*/expect(cofre.saldo).toBe(2);\n  /*@case 10.02.classe-mantem-saldo-encapsul-57579c6f*/expect(cofre.depositar(3)).toBe(true);\n  /*@case 10.02.classe-mantem-saldo-encapsul-4588a6cd*/expect(cofre.saldo).toBe(5);\n  /*@case 10.02.classe-mantem-saldo-encapsul-29c8909e*/expect('#saldo' in cofre).toBe(false);\n});\n\ntest('saldo nunca fica negativo por construção ou depósito inválido', () => {\n  const cofre = new Cofre(-4);\n  /*@case 10.02.saldo-nunca-fica-negativo-po-4ce62a78*/expect(cofre.saldo).toBe(0);\n  /*@case 10.02.saldo-nunca-fica-negativo-po-b1386e8d*/expect(cofre.depositar(0)).toBe(false);\n  /*@case 10.02.saldo-nunca-fica-negativo-po-ff473c17*/expect(cofre.depositar(-2)).toBe(false);\n  /*@case 10.02.saldo-nunca-fica-negativo-po-4ce62a78*/expect(cofre.saldo).toBe(0);\n});\n"},"reference":[{"path":"main.js","content":"export class Cofre {\n  #saldo;\n\n  constructor(inicial) {\n    this.#saldo = Math.max(0, inicial);\n  }\n\n  depositar(valor) {\n    if (!(valor > 0)) return false;\n    this.#saldo += valor;\n    return true;\n  }\n\n  get saldo() {\n    return this.#saldo;\n  }\n}\n\nconsole.log(new Cofre(2).saldo);\n"}]},{"item":{"id":"10.06","title":"Refatore para composição","stage":"10","kind":"MODIFY","contentVersion":2,"optional":false,"duration":"25 min","runtime":"Node.js 24 LTS · ECMAScript 2026 · módulos ES","compatibility":"Node.js 24 LTS with ESM unless the card explicitly compares another context; use built-ins only and retain the contract’s stated fallback for newer APIs.","objective":"Faça duas listas: estado de cada entidade e funções de capacidade. Marque quais combinações o starter realmente precisa oferecer.","prompt":"Investigue a hierarquia do starter e liste dados mutáveis separados de capacidades. Substitua a combinação de subclasses por composição para somente as capacidades configuradas. Antes de executar, preveja quais operações cada entidade expõe; depois teste duas entidades sem compartilhar estado.","firstResponse":{"action":"Faça duas listas: estado de cada entidade e funções de capacidade. Marque quais combinações o starter realmente precisa oferecer.","timing":"Nos primeiros 3 minutos, antes de modificar a hierarquia."},"explanation":{"mental_model":"Composição monta uma entidade a partir de dados próprios e capacidades escolhidas. Funções de capacidade podem receber a entidade explicitamente; compartilhar a função não significa compartilhar os dados mutáveis de cada instância.","worked_example":"Um instrumento pode receber `{bateria, capacidades}` e ganhar `emitirSom` e `piscar` apenas quando configurados. As funções de capacidade podem ser reutilizadas enquanto a bateria fica em cada instância. Um instrumento sem capacidade de piscar não precisa herdar uma classe combinatória para escondê-la.","common_trap":"Não crie uma subclasse para cada combinação nem guarde estado da entidade numa variável compartilhada pelo comportamento. Monte somente as capacidades declaradas e teste a ausência também.","why_it_matters":"Composição reduz combinações artificiais e deixa explícito o que cada objeto pode fazer. A separação facilita estender o motor sem criar hierarquias explosivas."},"interaction":"Editor de composição com checklist textual de capacidades e duas entidades; resultados mostram operações disponíveis e estado por objeto. Checklist acessível por teclado/leitor de tela.","resources":["Starter do exercício incluído no cartão: hierarquia artificial Personagem->MagoCuradorVoador; capacidades mover/atacar/curar recebem estado explícito","Documentação oficial indicada: MDN Classes: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Classes ; MDN Functions: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Functions"],"starterFiles":[{"path":"main.js","content":"export const mover = (estado, distancia) => { estado.x += distancia; return estado; };\nexport const atacar = (estado, alvo) => { alvo.vida -= estado.forca; return alvo; };\nexport const curar = (estado, quantidade) => { estado.vida += quantidade; return estado; };\n\nexport function criarPersonagem(dados, capacidades) {\n  return {estado: {...dados}, capacidades: {...capacidades}};\n}\n\nconst personagem = criarPersonagem({nome: \"Mira\", vida: 5, x: 0}, {mover, curar});\nconsole.log(JSON.stringify(Object.keys(personagem.capacidades)));\n"}],"assets":[],"examples":[{"given":"entidade com mover+curar","expected":"move e cura; entidade sem atacar -> não expõe atacar"}],"checks":[{"fixture":{"given":"entidade com mover+curar","expected":"move e cura; entidade sem atacar -> não expõe atacar"},"scoring":"Rode regressões antigas e novos casos; avalie mudança localizada."}],"constraints":[],"rubric":[],"learningMetadata":{"requires":["06.01","04.01"]},"edgeCases":["duas entidades compartilham função de capacidade -> funções compartilhadas, vida isolada por entidade"],"review":{"prompt":"Qual vantagem da composição sobre uma hierarquia com uma subclasse para cada combinação?","choices":["Combinar capacidades necessárias sem codificar cada combinação possível como tipo novo.","Garantir que todos os objetos exponham todos os métodos disponíveis.","Fazer com que instâncias diferentes usem obrigatoriamente o mesmo estado."],"answer":0,"correctFeedback":"Composição reúne comportamentos escolhidos e evita multiplicar subclasses para combinações.","incorrectFeedback":"Composição busca combinações menores e explícitas; não obriga a expor toda capacidade nem compartilhar estado."},"assessmentEnvironment":"javascript","autoTested":true,"preparation":{"guided":true,"stageTitle":"THIS, PROTÓTIPOS E CLASSES","introduction":"Faça duas listas: estado de cada entidade e funções de capacidade. Marque quais combinações o starter realmente precisa oferecer.","explanation":"Composição monta uma entidade a partir de dados próprios e capacidades escolhidas. Funções de capacidade podem receber a entidade explicitamente; compartilhar a função não significa compartilhar os dados mutáveis de cada instância.","conceptSteps":["Composição monta uma entidade a partir de dados próprios e capacidades escolhidas.","Funções de capacidade podem receber a entidade explicitamente; compartilhar a função não significa compartilhar os dados mutáveis de cada instância.","Composição reduz combinações artificiais e deixa explícito o que cada objeto pode fazer."],"vocabulary":["`emitirSom` — Um instrumento pode receber `{bateria, capacidades}` e ganhar `emitirSom` e `piscar` apenas quando configurados.","`piscar` — Um instrumento pode receber `{bateria, capacidades}` e ganhar `emitirSom` e `piscar` apenas quando configurados."],"workedExample":{"steps":["Um instrumento pode receber `{bateria, capacidades}` e ganhar `emitirSom` e `piscar` apenas quando configurados.","As funções de capacidade podem ser reutilizadas enquanto a bateria fica em cada instância.","Um instrumento sem capacidade de piscar não precisa herdar uma classe combinatória para escondê-la."]},"notes":["Não crie uma subclasse para cada combinação nem guarde estado da entidade numa variável compartilhada pelo comportamento. Monte somente as capacidades declaradas e teste a ausência também.","Composição reduz combinações artificiais e deixa explícito o que cada objeto pode fazer. A separação facilita estender o motor sem criar hierarquias explosivas."],"docs":[{"title":"Documentação oficial indicada: MDN Classes","url":"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Classes","section":"; MDN Functions: https://developer","question":"mozilla.org/en-US/docs/Web/JavaScript/Guide/Functions"}],"materials":["Starter do exercício incluído no cartão: hierarquia artificial Personagem->MagoCuradorVoador; capacidades mover/atacar/curar recebem estado explícito"],"predictionGuide":"Faça duas listas: estado de cada entidade e funções de capacidade. Marque quais combinações o starter realmente precisa oferecer. Nos primeiros 3 minutos, antes de modificar a hierarquia.","practiceSteps":["Investigue a hierarquia do starter e liste dados mutáveis separados de capacidades.","Substitua a combinação de subclasses por composição para somente as capacidades configuradas.","Antes de executar, preveja quais operações cada entidade expõe; depois teste duas entidades sem compartilhar estado."],"hints":["Releia o enunciado e separe entrada, saída e restrições: Investigue a hierarquia do starter e liste dados mutáveis separados de capacidades. Substitua a combinação de subclasses por composição para somente as capacidades configuradas. Antes de executar, preveja quais operações cada entidade expõe","Compare com o exemplo público — dado: entidade com mover+curar. Esperado: move e cura; entidade sem atacar -> não expõe atacar.","Cuidado com a armadilha desta atividade: Não crie uma subclasse para cada combinação nem guarde estado da entidade numa variável compartilhada pelo comportamento."],"reflectionPrompt":"Compare sua primeira resposta com o resultado da tentativa. Explique a regra que você praticou e um erro que ela ajuda a evitar."},"hints":["Releia o enunciado e separe entrada, saída e restrições: Investigue a hierarquia do starter e liste dados mutáveis separados de capacidades. Substitua a combinação de subclasses por composição para somente as capacidades configuradas. Antes de executar, preveja quais operações cada entidade expõe","Compare com o exemplo público — dado: entidade com mover+curar. Esperado: move e cura; entidade sem atacar -> não expõe atacar.","Cuidado com a armadilha desta atividade: Não crie uma subclasse para cada combinação nem guarde estado da entidade numa variável compartilhada pelo comportamento."]},"assessment":{"version":1,"checks":["behavior"],"environment":"javascript","testPath":"__devpath_tests__.js","referenceDir":"solutions/10.06","assertionCases":[{"id":"10.06.capacidades-sao-compostas-po-02380f8d","sourceTestPath":"tests/10.06.test.js","testName":"capacidades são compostas por entidade e não criam subclasses por combinação","inputExpression":"mago.capacidades.mover","matcher":"toBe","expectedExpression":"mover","negated":false,"initialArrangementExpression":"const mago = criarPersonagem({nome: 'Mira', vida: 5, x: 0}, {mover, curar});\n  const guerreiro = criarPersonagem({nome: 'Téo', vida: 8, x: 0}, {mover, atacar});","assertionExpression":"expect(mago.capacidades.mover).toBe(mover)","contractRule":"mago.capacidades.mover toBe mover","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(mago.capacidades.mover).toBe(mover)","assertionOffset":378,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"10.06.capacidades-sao-compostas-po-1ac110b0","sourceTestPath":"tests/10.06.test.js","testName":"capacidades são compostas por entidade e não criam subclasses por combinação","inputExpression":"mago.capacidades.curar","matcher":"toBe","expectedExpression":"curar","negated":false,"initialArrangementExpression":"const mago = criarPersonagem({nome: 'Mira', vida: 5, x: 0}, {mover, curar});\n  const guerreiro = criarPersonagem({nome: 'Téo', vida: 8, x: 0}, {mover, atacar});\n\n  expect(mago.capacidades.mover).toBe(mover);","assertionExpression":"expect(mago.capacidades.curar).toBe(curar)","contractRule":"mago.capacidades.curar toBe curar","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(mago.capacidades.curar).toBe(curar)","assertionOffset":477,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"10.06.capacidades-sao-compostas-po-88c100a2","sourceTestPath":"tests/10.06.test.js","testName":"capacidades são compostas por entidade e não criam subclasses por combinação","inputExpression":"'atacar' in mago.capacidades","matcher":"toBe","expectedExpression":"false","negated":false,"initialArrangementExpression":"const mago = criarPersonagem({nome: 'Mira', vida: 5, x: 0}, {mover, curar});\n  const guerreiro = criarPersonagem({nome: 'Téo', vida: 8, x: 0}, {mover, atacar});\n\n  expect(mago.capacidades.mover).toBe(mover);\n  expect(mago.capacidades.curar).toBe(curar);","assertionExpression":"expect('atacar' in mago.capacidades).toBe(false)","contractRule":"'atacar' in mago.capacidades toBe false","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect('atacar' in mago.capacidades).toBe(false)","assertionOffset":576,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"10.06.capacidades-sao-compostas-po-110373a8","sourceTestPath":"tests/10.06.test.js","testName":"capacidades são compostas por entidade e não criam subclasses por combinação","inputExpression":"guerreiro.capacidades.atacar","matcher":"toBe","expectedExpression":"atacar","negated":false,"initialArrangementExpression":"const mago = criarPersonagem({nome: 'Mira', vida: 5, x: 0}, {mover, curar});\n  const guerreiro = criarPersonagem({nome: 'Téo', vida: 8, x: 0}, {mover, atacar});\n\n  expect(mago.capacidades.mover).toBe(mover);\n  expect(mago.capacidades.curar).toBe(curar);\n  expect('atacar' in mago.capacidades).toBe(false);","assertionExpression":"expect(guerreiro.capacidades.atacar).toBe(atacar)","contractRule":"guerreiro.capacidades.atacar toBe atacar","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(guerreiro.capacidades.atacar).toBe(atacar)","assertionOffset":681,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"10.06.capacidades-sao-compostas-po-dd56b0fe","sourceTestPath":"tests/10.06.test.js","testName":"capacidades são compostas por entidade e não criam subclasses por combinação","inputExpression":"guerreiro.capacidades.curar","matcher":"toBe","expectedExpression":"undefined","negated":false,"initialArrangementExpression":"const mago = criarPersonagem({nome: 'Mira', vida: 5, x: 0}, {mover, curar});\n  const guerreiro = criarPersonagem({nome: 'Téo', vida: 8, x: 0}, {mover, atacar});\n\n  expect(mago.capacidades.mover).toBe(mover);\n  expect(mago.capacidades.curar).toBe(curar);\n  expect('atacar' in mago.capacidades).toBe(false);\n  expect(guerreiro.capacidades.atacar).toBe(atacar);","assertionExpression":"expect(guerreiro.capacidades.curar).toBe(undefined)","contractRule":"guerreiro.capacidades.curar toBe undefined","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(guerreiro.capacidades.curar).toBe(undefined)","assertionOffset":787,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"10.06.funcoes-de-capacidade-compar-f21b0215","sourceTestPath":"tests/10.06.test.js","testName":"funções de capacidade compartilhadas recebem e devolvem estado isolado","inputExpression":"deslocada","matcher":"toEqual","expectedExpression":"{nome: 'Mira', vida: 5, x: 3, forca: 1}","negated":false,"initialArrangementExpression":"const original = {nome: 'Mira', vida: 5, x: 0, forca: 1};\n  const deslocada = mover(original, 3);\n  const curada = curar(original, 2);\n  const ferida = atacar(original, {vida: 9});","assertionExpression":"expect(deslocada).toEqual({nome: 'Mira', vida: 5, x: 3, forca: 1})","contractRule":"deslocada toEqual {nome: 'Mira', vida: 5, x: 3, forca: 1}","investigation":"Confira a expressão de entrada e a comparação toEqual deste caso: expect(deslocada).toEqual({nome: 'Mira', vida: 5, x: 3, forca: 1})","assertionOffset":1171,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"10.06.funcoes-de-capacidade-compar-71dab4f9","sourceTestPath":"tests/10.06.test.js","testName":"funções de capacidade compartilhadas recebem e devolvem estado isolado","inputExpression":"curada","matcher":"toEqual","expectedExpression":"{nome: 'Mira', vida: 7, x: 0, forca: 1}","negated":false,"initialArrangementExpression":"const original = {nome: 'Mira', vida: 5, x: 0, forca: 1};\n  const deslocada = mover(original, 3);\n  const curada = curar(original, 2);\n  const ferida = atacar(original, {vida: 9});\n\n  expect(deslocada).toEqual({nome: 'Mira', vida: 5, x: 3, forca: 1});","assertionExpression":"expect(curada).toEqual({nome: 'Mira', vida: 7, x: 0, forca: 1})","contractRule":"curada toEqual {nome: 'Mira', vida: 7, x: 0, forca: 1}","investigation":"Confira a expressão de entrada e a comparação toEqual deste caso: expect(curada).toEqual({nome: 'Mira', vida: 7, x: 0, forca: 1})","assertionOffset":1294,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"10.06.funcoes-de-capacidade-compar-be009c3b","sourceTestPath":"tests/10.06.test.js","testName":"funções de capacidade compartilhadas recebem e devolvem estado isolado","inputExpression":"ferida","matcher":"toEqual","expectedExpression":"{vida: 8}","negated":false,"initialArrangementExpression":"const original = {nome: 'Mira', vida: 5, x: 0, forca: 1};\n  const deslocada = mover(original, 3);\n  const curada = curar(original, 2);\n  const ferida = atacar(original, {vida: 9});\n\n  expect(deslocada).toEqual({nome: 'Mira', vida: 5, x: 3, forca: 1});\n  expect(curada).toEqual({nome: 'Mira', vida: 7, x: 0, forca: 1});","assertionExpression":"expect(ferida).toEqual({vida: 8})","contractRule":"ferida toEqual {vida: 8}","investigation":"Confira a expressão de entrada e a comparação toEqual deste caso: expect(ferida).toEqual({vida: 8})","assertionOffset":1414,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"10.06.funcoes-de-capacidade-compar-18f4af5c","sourceTestPath":"tests/10.06.test.js","testName":"funções de capacidade compartilhadas recebem e devolvem estado isolado","inputExpression":"original","matcher":"toEqual","expectedExpression":"{nome: 'Mira', vida: 5, x: 0, forca: 1}","negated":false,"initialArrangementExpression":"const original = {nome: 'Mira', vida: 5, x: 0, forca: 1};\n  const deslocada = mover(original, 3);\n  const curada = curar(original, 2);\n  const ferida = atacar(original, {vida: 9});\n\n  expect(deslocada).toEqual({nome: 'Mira', vida: 5, x: 3, forca: 1});\n  expect(curada).toEqual({nome: 'Mira', vida: 7, x: 0, forca: 1});\n  expect(ferida).toEqual({vida: 8});","assertionExpression":"expect(original).toEqual({nome: 'Mira', vida: 5, x: 0, forca: 1})","contractRule":"original toEqual {nome: 'Mira', vida: 5, x: 0, forca: 1}","investigation":"Confira a expressão de entrada e a comparação toEqual deste caso: expect(original).toEqual({nome: 'Mira', vida: 5, x: 0, forca: 1})","assertionOffset":1504,"assertionApi":"expect","executionScope":"browser-behavior-suite"}],"sourceTestPath":"tests/10.06.test.js","tests":"import {atacar, curar, criarPersonagem, mover} from './main.js';\n\ntest('capacidades são compostas por entidade e não criam subclasses por combinação', () => {\n  const mago = criarPersonagem({nome: 'Mira', vida: 5, x: 0}, {mover, curar});\n  const guerreiro = criarPersonagem({nome: 'Téo', vida: 8, x: 0}, {mover, atacar});\n\n  /*@case 10.06.capacidades-sao-compostas-po-02380f8d*/expect(mago.capacidades.mover).toBe(mover);\n  /*@case 10.06.capacidades-sao-compostas-po-1ac110b0*/expect(mago.capacidades.curar).toBe(curar);\n  /*@case 10.06.capacidades-sao-compostas-po-88c100a2*/expect('atacar' in mago.capacidades).toBe(false);\n  /*@case 10.06.capacidades-sao-compostas-po-110373a8*/expect(guerreiro.capacidades.atacar).toBe(atacar);\n  /*@case 10.06.capacidades-sao-compostas-po-dd56b0fe*/expect(guerreiro.capacidades.curar).toBe(undefined);\n});\n\ntest('funções de capacidade compartilhadas recebem e devolvem estado isolado', () => {\n  const original = {nome: 'Mira', vida: 5, x: 0, forca: 1};\n  const deslocada = mover(original, 3);\n  const curada = curar(original, 2);\n  const ferida = atacar(original, {vida: 9});\n\n  /*@case 10.06.funcoes-de-capacidade-compar-f21b0215*/expect(deslocada).toEqual({nome: 'Mira', vida: 5, x: 3, forca: 1});\n  /*@case 10.06.funcoes-de-capacidade-compar-71dab4f9*/expect(curada).toEqual({nome: 'Mira', vida: 7, x: 0, forca: 1});\n  /*@case 10.06.funcoes-de-capacidade-compar-be009c3b*/expect(ferida).toEqual({vida: 8});\n  /*@case 10.06.funcoes-de-capacidade-compar-18f4af5c*/expect(original).toEqual({nome: 'Mira', vida: 5, x: 0, forca: 1});\n});\n"},"reference":[{"path":"main.js","content":"export const mover = (estado, distancia) => ({...estado, x: estado.x + distancia});\nexport const atacar = (estado, alvo) => ({...alvo, vida: alvo.vida - estado.forca});\nexport const curar = (estado, quantidade) => ({...estado, vida: estado.vida + quantidade});\nexport function criarPersonagem(dados, capacidades) { return {estado: {...dados}, capacidades: {...capacidades}}; }\n"}]},{"item":{"id":"10.07","title":"Transferencia - composicao vs heranca","stage":"10","kind":"TRANSFER","contentVersion":2,"optional":false,"duration":"25 min","runtime":"Node.js 24 LTS · ECMAScript 2026 · módulos ES","compatibility":"Node.js 24 LTS with ESM unless the card explicitly compares another context; use built-ins only and retain the contract’s stated fallback for newer APIs.","objective":"Escreva para cada cenário um requisito de substituição e um eixo de variação, antes de escolher a estrutura.","prompt":"Analise os dois cenários do starter separadamente. Para cada um, identifique se a relação proposta preserva comportamento ou se uma política varia independentemente. Depois implemente a decisão do cenário de estratégia e escreva testes que expressem a troca sem depender de subclasses.","firstResponse":{"action":"Escreva para cada cenário um requisito de substituição e um eixo de variação, antes de escolher a estrutura.","timing":"Nos primeiros 3 minutos, antes de alterar o código."},"explanation":{"mental_model":"Herança expressa substituição comportamental: uma instância derivada deve cumprir os contratos que os consumidores esperam da base. Composição é útil quando partes ou políticas variam independentemente e podem ser trocadas sem redefinir uma hierarquia.","worked_example":"Em um relatório que pode ser exportado como CSV ou JSON, a política de formato varia independentemente do conteúdo do relatório. Um `exportador` injetado permite mudar a política sem criar uma classe filha para cada relatório e formato. Antes de herdar, pergunte se a substituição preserva invariantes e expectativas dos clientes.","common_trap":"Não escolha herança apenas por campos ou nomes parecidos. Verifique contratos mutáveis e se o subtipo pode realmente ocupar o lugar da base em todos os usos.","why_it_matters":"Avaliar substituição e eixos de variação ajuda a escolher entre extensão e composição. Testes tornam visíveis os trade-offs do desenho."},"interaction":"Quadro comparativo acessível com colunas cenário, invariante, variação e decisão; depois editor para estratégia injetável e teste de troca. Não depende de cor ou arraste.","resources":["Starter do exercício incluído no cartão: cenário A: quadrado/retângulo com setter de dimensões; cenário B: notificação email/SMS com canal intercambiável","Documentação oficial indicada: MDN Using classes: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Using_classes ; MDN extends: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Classes/extends"],"starterFiles":[{"path":"main.js","content":"export class Retangulo {\n  constructor(largura, altura) { this.largura = largura; this.altura = altura; }\n  get area() { return this.largura * this.altura; }\n}\n\nexport class Quadrado extends Retangulo {\n  set largura(valor) { this._largura = valor; this._altura = valor; }\n  get largura() { return this._largura; }\n  set altura(valor) { this._largura = valor; this._altura = valor; }\n  get altura() { return this._altura; }\n}\n\nexport function criarNotificador(canal) {\n  return {enviar(mensagem) { return mensagem; }};\n}\n\nconsole.log(new Retangulo(3, 4).area);\n"}],"assets":[],"examples":[{"given":"A","expected":"composição/contratos separados; B -> estratégia de canal; justificativa cita invariantes"}],"checks":[{"fixture":{"given":"A","expected":"composição/contratos separados; B -> estratégia de canal; justificativa cita invariantes"},"scoring":"Compare competência estrutural em domínio diferente e sem ajuda."}],"constraints":[],"rubric":["Identifica por que Quadrado com setters dimensionais viola a substituibilidade esperada.","Implementa ou descreve um canal intercambiável por composição e aponta o comportamento executado."],"learningMetadata":{"requires":["06.01","04.01"]},"edgeCases":["trocar canal em runtime -> sem nova subclasse; setter de largura do quadrado -> não satisfaz comportamento de retângulo geral"],"review":{"prompt":"Que custo de manutenção pode surgir quando subclasses representam cada combinação de políticas independentes?","choices":["As classes deixam de poder declarar métodos próprios.","A quantidade de tipos pode crescer conforme se multiplicam as combinações.","O runtime passa a escolher automaticamente a política mais adequada."],"answer":1,"correctFeedback":"Eixos independentes combinados em subclasses podem multiplicar tipos e duplicar decisões.","incorrectFeedback":"O risco é o crescimento combinatório do modelo; subclasses continuam podendo ter métodos e não são escolhidas automaticamente."},"assessmentEnvironment":"javascript","rubricFingerprint":"sha256:30dca959dc2033fb976837054bb40cafcd7cf37e63d8b74402a5fddc5d217a67","autoTested":true,"preparation":{"guided":true,"stageTitle":"THIS, PROTÓTIPOS E CLASSES","introduction":"Escreva para cada cenário um requisito de substituição e um eixo de variação, antes de escolher a estrutura.","explanation":"Herança expressa substituição comportamental: uma instância derivada deve cumprir os contratos que os consumidores esperam da base. Composição é útil quando partes ou políticas variam independentemente e podem ser trocadas sem redefinir uma hierarquia.","conceptSteps":["Herança expressa substituição comportamental: uma instância derivada deve cumprir os contratos que os consumidores esperam da base.","Composição é útil quando partes ou políticas variam independentemente e podem ser trocadas sem redefinir uma hierarquia.","Avaliar substituição e eixos de variação ajuda a escolher entre extensão e composição."],"vocabulary":["`exportador` — Um `exportador` injetado permite mudar a política sem criar uma classe filha para cada relatório e formato."],"workedExample":{"steps":["Em um relatório que pode ser exportado como CSV ou JSON, a política de formato varia independentemente do conteúdo do relatório.","Um `exportador` injetado permite mudar a política sem criar uma classe filha para cada relatório e formato.","Antes de herdar, pergunte se a substituição preserva invariantes e expectativas dos clientes."]},"notes":["Não escolha herança apenas por campos ou nomes parecidos. Verifique contratos mutáveis e se o subtipo pode realmente ocupar o lugar da base em todos os usos.","Avaliar substituição e eixos de variação ajuda a escolher entre extensão e composição. Testes tornam visíveis os trade-offs do desenho."],"docs":[{"title":"Documentação oficial indicada: MDN Using classes","url":"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Using_classes","section":"; MDN extends: https://developer","question":"mozilla.org/en-US/docs/Web/JavaScript/Reference/Classes/extends"}],"materials":["Starter do exercício incluído no cartão: cenário A: quadrado/retângulo com setter de dimensões; cenário B: notificação email/SMS com canal intercambiável"],"predictionGuide":"Escreva para cada cenário um requisito de substituição e um eixo de variação, antes de escolher a estrutura. Nos primeiros 3 minutos, antes de alterar o código.","practiceSteps":["Analise os dois cenários do starter separadamente.","Para cada um, identifique se a relação proposta preserva comportamento ou se uma política varia independentemente.","Depois implemente a decisão do cenário de estratégia e escreva testes que expressem a troca sem depender de subclasses."],"hints":["Releia o enunciado e separe entrada, saída e restrições: Analise os dois cenários do starter separadamente. Para cada um, identifique se a relação proposta preserva comportamento ou se uma política varia independentemente. Depois implemente a decisão do cenário de estratégia e escreva testes que ","Compare com o exemplo público — dado: A. Esperado: composição/contratos separados; B -> estratégia de canal; justificativa cita invariantes.","Cuidado com a armadilha desta atividade: Não escolha herança apenas por campos ou nomes parecidos."],"reflectionPrompt":"Compare sua primeira resposta com o resultado da tentativa. Explique a regra que você praticou e um erro que ela ajuda a evitar."},"hints":["Releia o enunciado e separe entrada, saída e restrições: Analise os dois cenários do starter separadamente. Para cada um, identifique se a relação proposta preserva comportamento ou se uma política varia independentemente. Depois implemente a decisão do cenário de estratégia e escreva testes que ","Compare com o exemplo público — dado: A. Esperado: composição/contratos separados; B -> estratégia de canal; justificativa cita invariantes.","Cuidado com a armadilha desta atividade: Não escolha herança apenas por campos ou nomes parecidos."]},"assessment":{"version":1,"checks":["behavior","rubric"],"environment":"javascript","testPath":"__devpath_tests__.js","referenceDir":"solutions/10.07","rubric":["Identifica por que Quadrado com setters dimensionais viola a substituibilidade esperada.","Implementa ou descreve um canal intercambiável por composição e aponta o comportamento executado."],"assertionCases":[{"id":"10.07.notificador-usa-canal-interc-18e3454d","sourceTestPath":"tests/10.07.test.js","testName":"notificador usa canal intercambiável sem criar subclasses por canal","inputExpression":"notificador.enviar('Olá')","matcher":"toBe","expectedExpression":"'email-ok'","negated":false,"initialArrangementExpression":"const mensagens = [];\n  const email = {enviar(texto) {mensagens.push(`email:${texto}`); return 'email-ok';}};\n  const sms = {enviar(texto) {mensagens.push(`sms:${texto}`); return 'sms-ok';}};\n  const notificador = criarNotificador(email);","assertionExpression":"expect(notificador.enviar('Olá')).toBe('email-ok')","contractRule":"notificador.enviar('Olá') toBe 'email-ok'","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(notificador.enviar('Olá')).toBe('email-ok')","assertionOffset":425,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"10.07.notificador-usa-canal-interc-f9f856f1","sourceTestPath":"tests/10.07.test.js","testName":"notificador usa canal intercambiável sem criar subclasses por canal","inputExpression":"criarNotificador(sms).enviar('Oi')","matcher":"toBe","expectedExpression":"'sms-ok'","negated":false,"initialArrangementExpression":"const mensagens = [];\n  const email = {enviar(texto) {mensagens.push(`email:${texto}`); return 'email-ok';}};\n  const sms = {enviar(texto) {mensagens.push(`sms:${texto}`); return 'sms-ok';}};\n  const notificador = criarNotificador(email);\n  expect(notificador.enviar('Olá')).toBe('email-ok');","assertionExpression":"expect(criarNotificador(sms).enviar('Oi')).toBe('sms-ok')","contractRule":"criarNotificador(sms).enviar('Oi') toBe 'sms-ok'","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(criarNotificador(sms).enviar('Oi')).toBe('sms-ok')","assertionOffset":532,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"10.07.notificador-usa-canal-interc-e83c5f54","sourceTestPath":"tests/10.07.test.js","testName":"notificador usa canal intercambiável sem criar subclasses por canal","inputExpression":"mensagens","matcher":"toEqual","expectedExpression":"['email:Olá', 'sms:Oi']","negated":false,"initialArrangementExpression":"const mensagens = [];\n  const email = {enviar(texto) {mensagens.push(`email:${texto}`); return 'email-ok';}};\n  const sms = {enviar(texto) {mensagens.push(`sms:${texto}`); return 'sms-ok';}};\n  const notificador = criarNotificador(email);\n  expect(notificador.enviar('Olá')).toBe('email-ok');\n  expect(criarNotificador(sms).enviar('Oi')).toBe('sms-ok');","assertionExpression":"expect(mensagens).toEqual(['email:Olá', 'sms:Oi'])","contractRule":"mensagens toEqual ['email:Olá', 'sms:Oi']","investigation":"Confira a expressão de entrada e a comparação toEqual deste caso: expect(mensagens).toEqual(['email:Olá', 'sms:Oi'])","assertionOffset":646,"assertionApi":"expect","executionScope":"browser-behavior-suite"}],"sourceTestPath":"tests/10.07.test.js","tests":"import {criarNotificador} from './main.js';\n\ntest('notificador usa canal intercambiável sem criar subclasses por canal', () => {\n  const mensagens = [];\n  const email = {enviar(texto) {mensagens.push(`email:${texto}`); return 'email-ok';}};\n  const sms = {enviar(texto) {mensagens.push(`sms:${texto}`); return 'sms-ok';}};\n  const notificador = criarNotificador(email);\n  /*@case 10.07.notificador-usa-canal-interc-18e3454d*/expect(notificador.enviar('Olá')).toBe('email-ok');\n  /*@case 10.07.notificador-usa-canal-interc-f9f856f1*/expect(criarNotificador(sms).enviar('Oi')).toBe('sms-ok');\n  /*@case 10.07.notificador-usa-canal-interc-e83c5f54*/expect(mensagens).toEqual(['email:Olá', 'sms:Oi']);\n});\n"},"reference":[{"path":"main.js","content":"export class Retangulo {\n  constructor(largura, altura) { this.largura = largura; this.altura = altura; }\n  get area() { return this.largura * this.altura; }\n}\n\nexport class Quadrado extends Retangulo {\n  set largura(valor) { this._largura = valor; this._altura = valor; }\n  get largura() { return this._largura; }\n  set altura(valor) { this._largura = valor; this._altura = valor; }\n  get altura() { return this._altura; }\n}\n\nexport function criarNotificador(canal) {\n  return {enviar(mensagem) { return canal.enviar(mensagem); }};\n}\n\nconsole.log(new Retangulo(3, 4).area);\n"}]}];
  const errors = [], results = [];
  page.on('pageerror', error => errors.push(error.message));
  try {
    for (const row of rows) {
      const id = row.item.id;
      await page.goto('http://127.0.0.1:8765/devpath.html#/javascript/' + id);
      await page.getByRole('button', {name: 'Aprender este conceito', exact: true}).click();
      if (row.assessment.predictionTable) {
        for (const field of row.assessment.predictionTable.fields) await page.locator(`[data-prediction-field="${field.id}"]`).fill(row.prediction[field.id]);
      } else {
        await page.locator(`[data-first-response-input="${id}"]`).fill('QA: vou seguir as entradas, saídas e bordas publicadas para esta implementação.');
      }
      await page.locator(`[data-course-first-response="${id}"]`).click();
      const editor = page.locator(`[data-course-editor="${id}"]`).first();
      await editor.waitFor();
      const outcomes = await page.evaluate(async ({item, assessment, reference}) => {
        const run = files => window.DevPathAssessment.run({item, assessment, files, fingerprint: 'browser-phase2-core-' + item.id});
        const starter = await run(item.starterFiles), correct = await run(reference);
        return {starter: {kind: starter.kind, tests: starter.tests, text: starter.text}, reference: {kind: correct.kind, tests: correct.tests, text: correct.text}};
      }, row);
      if (outcomes.reference.kind !== 'passed' || !outcomes.reference.tests?.total) throw new Error(id + ' reference: ' + JSON.stringify(outcomes.reference));
      const expectStarterFailure = !['PREDICT', 'TRACE'].includes(row.item.kind) && id !== '04.10';
      if (expectStarterFailure && outcomes.starter.kind !== 'failed') throw new Error(id + ' starter: ' + JSON.stringify(outcomes.starter));
      for (const file of row.reference) {
        const field = page.locator(`[data-course-editor="${id}"][data-course-file="${file.path}"]`);
        if (await field.count()) await field.fill(file.content);
      }
      await page.locator(`[data-course-run="${id}"]`).click();
      await page.waitForFunction(id => {
        const text = document.querySelector(`[data-course-output="${id}"]`)?.textContent || '';
        return text && !text.includes('Preparando avaliação local') && !text.includes('A saída aparecerá');
      }, id, {timeout: 30000});
      const output = await page.locator(`[data-course-output="${id}"]`).textContent();
      if (output.includes('Corrija o trabalho')) throw new Error(id + ' UI reference: ' + output);
      if (row.assessment.predictionTable && !output.includes(`${row.assessment.predictionTable.fields.length} coincidiram`)) throw new Error(id + ' prediction: ' + output);
      await page.locator(`[data-course-reflection="${id}"]`).fill('QA: conferi os resultados e os casos de borda com o contrato da atividade.');
      const checks = page.locator(`[data-course-rubric="${id}"]`);
      for (let index = 0; index < await checks.count(); index++) await checks.nth(index).check();
      const complete = page.locator(`[data-course-complete="${id}"]`);
      if (await complete.isDisabled()) throw new Error(id + ' completion remains disabled');
      await complete.click();
      await page.waitForFunction(id => JSON.parse(localStorage.getItem('devpath-local-preview-v1') || '{}').answers?.[id] === true, id);
      const draft = await editor.inputValue();
      await page.waitForTimeout(700);
      await page.reload(); await editor.waitFor();
      if (draft !== await editor.inputValue()) throw new Error(id + ' draft lost');
      const saved = await page.evaluate(id => {
        const progress = JSON.parse(localStorage.getItem('devpath-local-preview-v1') || '{}');
        return {completed: progress.answers?.[id], state: progress.exerciseLearning?.[id]?.state, prediction: progress.exercisePredictions?.[id]};
      }, id);
      if (!saved.completed || saved.state !== 'verified') throw new Error(id + ' learning evidence: ' + JSON.stringify(saved));
      results.push({id, ...outcomes, predictionCompared: Boolean(row.prediction), draftRestored: true, ...saved});
    }
    if (errors.length) throw new Error(errors.join('; '));
    return {results, pageErrors: errors, origin: 'QA, not a learner study sample'};
  } finally { await context.close(); }
}))(page);
