{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "dist", "rootDir": "src", "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.mts"]
}
