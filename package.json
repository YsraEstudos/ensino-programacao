{
  "name": "devpath",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "assets:version": "node scripts/update-asset-versions.mjs",
    "predev": "npm run build:progress && npm run assets:version",
    "test:app": "node --test scripts/test-app-maintenance.mjs scripts/test-review-schedule.mjs scripts/test-course-runner.mjs",
    "test:stage02": "node --test scripts/test-stage02.mjs scripts/test-stage02-ui.mjs scripts/test-stage02-progress.mjs scripts/test-stage02-audit.mjs",
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build:lessons": "npm run build:curriculum",
    "test:diagnostic": "node --test scripts/test-diagnostic.mjs",
    "prebuild": "node scripts/prebuild.mjs",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test:stage01": "node --test scripts/test-stage01-runner.mjs scripts/test-stage01-checks.mjs scripts/test-stage01-content.mjs scripts/test-stage01-ui.mjs scripts/test-stage01-progress.mjs scripts/test-stage01-integration.mjs scripts/test-stage01-flow.mjs",
    "test:stage00": "node scripts/test-stage00-content.mjs && node scripts/test-stage00-ui.mjs",
    "test:stage03": "node --test scripts/test-stage03-runner.mjs scripts/test-stage03-content.mjs scripts/test-stage03-ui.mjs scripts/test-stage03-progress.mjs scripts/test-stage03-scope.mjs scripts/test-stage03-runtime.mjs",
    "pretest:stage03": "npm run build:curriculum",
    "build:stage03": "npm run build:curriculum",
    "build:curriculum": "node scripts/build-curriculum-data.mjs",
    "check:curriculum": "node course-src/build-public-curriculum.mjs --check && node scripts/validate-course-catalog.mjs && node scripts/validate-curriculum-source.mjs",
    "precheck:curriculum": "npm run build:curriculum",
    "test:layout": "node --test scripts/test-project-layout.mjs",
    "pretest:layout": "npm run build:curriculum",
    "pretest:stage02": "npm run build:curriculum",
    "test": "npm run test:progress && npm run test:app && npm run test:layout && npm run test:diagnostic && npm run test:stage00 && npm run test:stage01 && npm run test:stage02 && npm run test:stage03",
    "build:progress": "node scripts/build-progress-model.mjs",
    "test:progress": "node --test scripts/test-progress-api.mjs scripts/test-progress-client.mjs scripts/test-progress-model.mjs",
    "pretest": "npm run build:progress"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.1.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
