path_tests__.js","referenceDir":"solutions/04.08","assertionCases":[{"id":"04.08.calcula-peso-e-distancia-sep-0082c581","sourceTestPath":"tests/04.08.test.js","testName":"calcula peso e distância separadamente e compõe o total","inputExpression":"custoPeso(2)","matcher":"toBe","expectedExpression":"4","negated":false,"initialArrangementExpression":"sem setup anterior dentro deste teste","assertionExpression":"expect(custoPeso(2)).toBe(4)","contractRule":"custoPeso(2) toBe 4","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(custoPeso(2)).toBe(4)","assertionOffset":254,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"04.08.calcula-peso-e-distancia-sep-c5c25566","sourceTestPath":"tests/04.08.test.js","testName":"calcula peso e distância separadamente e compõe o total","inputExpression":"custoDistancia(10)","matcher":"toBe","expectedExpression":"1","negated":false,"initialArrangementExpression":"expect(custoPeso(2)).toBe(4);","assertionExpression":"expect(custoDistancia(10)).toBe(1)","contractRule":"custoDistancia(10) toBe 1","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(custoDistancia(10)).toBe(1)","assertionOffset":341,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"04.08.calcula-peso-e-distancia-sep-cf9eeea6","sourceTestPath":"tests/04.08.test.js","testName":"calcula peso e distância separadamente e compõe o total","inputExpression":"frete(2, 10)","matcher":"toBe","expectedExpression":"5","negated":false,"initialArrangementExpression":"expect(custoPeso(2)).toBe(4);\n    expect(custoDistancia(10)).toBe(1);","assertionExpression":"expect(frete(2, 10)).toBe(5)","contractRule":"frete(2, 10) toBe 5","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(frete(2, 10)).toBe(5)","assertionOffset":434,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"04.08.preserva-zero-e-valores-frac-7adc9d7e","sourceTestPath":"tests/04.08.test.js","testName":"preserva zero e valores fracionários válidos","inputExpression":"custoPeso(0)","matcher":"toBe","expectedExpression":"0","negated":false,"initialArrangementExpression":"sem setup anterior dentro deste teste","assertionExpression":"expect(custoPeso(0)).toBe(0)","contractRule":"custoPeso(0) toBe 0","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(custoPeso(0)).toBe(0)","assertionOffset":591,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"04.08.preserva-zero-e-valores-frac-20cf0e30","sourceTestPath":"tests/04.08.test.js","testName":"preserva zero e valores fracionários válidos","inputExpression":"custoDistancia(0)","matcher":"toBe","expectedExpression":"0","negated":false,"initialArrangementExpression":"expect(custoPeso(0)).toBe(0);","assertionExpression":"expect(custoDistancia(0)).toBe(0)","contractRule":"custoDistancia(0) toBe 0","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(custoDistancia(0)).toBe(0)","assertionOffset":678,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"04.08.preserva-zero-e-valores-frac-605d4704","sourceTestPath":"tests/04.08.test.js","testName":"preserva zero e valores fracionários válidos","inputExpression":"frete(0, 0)","matcher":"toBe","expectedExpression":"0","negated":false,"initialArrangementExpression":"expect(custoPeso(0)).toBe(0);\n    expect(custoDistancia(0)).toBe(0);","assertionExpression":"expect(frete(0, 0)).toBe(0)","contractRule":"frete(0, 0) toBe 0","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(frete(0, 0)).toBe(0)","assertionOffset":770,"assertionApi":"expect","executionScope":"browser-behavior-suite"},{"id":"04.08.preserva-zero-e-valores-frac-c2c10c0c","sourceTestPath":"tests/04.08.test.js","testName":"preserva zero e valores fracionários válidos","inputExpression":"frete(1.5, 2)","matcher":"toBe","expectedExpression":"3.2","negated":false,"initialArrangementExpression":"expect(custoPeso(0)).toBe(0);\n    expect(custoDistancia(0)).toBe(0);\n    expect(frete(0, 0)).toBe(0);","assertionExpression":"expect(frete(1.5, 2)).toBe(3.2)","contractRule":"frete(1.5, 2) toBe 3.2","investigation":"Confira a expressão de entrada e a comparação toBe deste caso: expect(frete(1.5, 2)).toBe(3.2)","assertionOffset":856,"assertionApi":"expect","executionScope":"browser-behavior-suite"}],"sourceTestPath":"tests/04.08.test.js","tests":"import {custoPeso, custoDistancia, frete} from './main.js';\n\ndescribe('frete por responsabilidades independentes', () => {\n  test('calcula peso e distância separadamente e compõe o total', () => {\n    /*@case 04.08.calcula-peso-e-distancia-sep-0082c581*/expect(custoPeso(2)).toBe(4);\n    /*@case 04.08.calcula-peso-e-distancia-sep-c5c25566*/expect(custoDistancia(10)).toBe(1);\n    /*@case 04.08.calcula-peso-e-distancia-sep-cf9eeea6*/expect(frete(2, 10)).toBe(5);\n  });\n\n  test('preserva zero e valores fracionários válidos', () => {\n    /*@case 04.08.preserva-zero-e-valores-frac-7adc9d7e*/expect(custoPeso(0)).toBe(0);\n    /*@case 04.08.preserva-zero-e-valores-frac-20cf0e30*/expect(custoDistancia(0)).toBe(0);\n    /*@case 04.08.preserva-zero-e-valores-frac-605d4704*/expect(frete(0, 0)).toBe(0);\n    /*@case 04.08.preserva-zero-e-valores-frac-c2c10c0c*/expect(frete(1.5, 2)).toBe(3.2);\n  });\n});\n"},"reference":[{"path":"main.js","content":"export function custoPeso(kg) { return kg * 2; }\nexport function custoDistancia(km) { return km * 0.1; }\nexport function frete(kg, km) { return custoPeso(kg) + custoDistancia(km); }\n"}]},{"item":{"id":"04.10","title":"Renomear para explicar","stage":"04","kind":"MODIFY","contentVersion":2,"optional":false,"duration":"24 min","runtime":"Node.js 24 LTS · ECMAScript 2026 · módulos ES","compatibility":"Sintaxe e APIs padrão disponíveis no Node.js 24 LTS; sem dependências externas.","objective":"Liste cada identificador interno, seu papel e novo nome; identifique quais pertencem à API que deve ficar estável.","prompt":"Renomeie os identificadores internos do módulo de pedidos para explicitar o subtotal e o resultado final. Preserve a função exportada, os parâmetros, as fórmulas e o comportamento para entradas válidas.","firstResponse":{"action":"Liste cada identificador interno, seu papel e novo nome; identifique quais pertencem à API que deve ficar estável.","timing":"Antes de executar, pedir dica ou abrir a solução."},"explanation":{"mental_model":"Um bom nome comunica intenção e unidade. Refatorar nomes é mudança estrutural: para as mesmas entradas, comportamento observável deve permanecer igual.","worked_example":"Num módulo de biblioteca, x pode virar quantidadeDePaginas e uma função privada contar pode virar contarPaginas. Faça as trocas sem alterar operações nem o nome exportado usado por consumidores.","common_trap":"Misturar renomeação e mudança de algoritmo torna difícil saber a causa de divergência e pode quebrar API pública.","why_it_matters":"Nomes claros reduzem esforço para entender legado e ajudam revisão e manutenção."},"interaction":"Edite os identificadores internos no starter; registre nome antigo → novo e o papel de cada um. Em seguida, percorra os dois exemplos públicos e confira que a assinatura exportada e os resultados permanecem iguais; todas as ações devem operar por teclado.","resources":["Starter main.js com a função exportada totalPedido e auxiliares internas de nomes genéricos.","Contrato visível no enunciado: argumentos numéricos não negativos; retorno é max(0, preço unitário × quantidade − desconto). Exemplos públicos de entrada e saída."],"starterFiles":[{"path":"main.js","content":"export function totalPedido(precoUnitario, quantidade, desconto) {\n  const data = precoUnitario * quantidade;\n  const thing = d(data - desconto);\n  return thing;\n}\nfunction d(x) {\n  return Math.max(0, x);\n}\n"}],"assets":[],"examples":[{"given":"totalPedido(10,2,3)","expected":"17; totalPedido(0,4,0) -> 0"}],"checks":[{"fixture":{"given":"totalPedido(10,2,3)","expected":"17; totalPedido(0,4,0) -> 0"},"scoring":"Rode regressões antigas e novos casos; avalie mudança localizada."}],"constraints":[],"rubric":["Renomeia apenas identificadores internos para expressar subtotal e resultado final.","Preserva totalPedido, parâmetros, fórmula e todos os resultados da suíte protegida."],"learningMetadata":{"requires":["04.07"]},"edgeCases":["totalPedido(4,3,20) -> 0; totalPedido(4,3,0) -> 12; API pública inalterada; entradas numéricas não negativas"],"review":{"prompt":"Que evidência sustenta uma refatoração que deveria mudar apenas nomes internos?","choices":["O programa inicia sem erro, mesmo que as saídas e a interface pública não sejam comparadas.","Os nomes ficaram mais claros e as verificações existentes preservam interface e comportamento.","Comentários descrevem a intenção, então não é necessário executar verificações."],"answer":1,"correctFeedback":"Correto: testes de regressão e a interface preservada mostram que a mudança foi apenas de legibilidade.","incorrectFeedback":"Iniciar sem erro ou adicionar comentários não demonstra equivalência. Compare comportamento observável e contrato público."},"assessmentEnvironment":"javascript","rubricFingerprint":"sha256:ef1c43cf8817ed1aa0c25770d52ae376fb2bb523e1ae9acd6570b6bc3fa2384d","autoTested":true,"preparation":{"guided":true,"stageTitle":"FUNÇÕES, RETORNO E ERROS","introduction":"Liste cada identificador interno, seu papel e novo nome; identifique quais pertencem à API que deve ficar estável.","explanation":"Um bom nome comunica intenção e unidade. Refatorar nomes é mudança estrutural: para as mesmas entradas, comportamento observável deve permanecer igual.","conceptSteps":["Um bom nome comunica intenção e unidade.","Refatorar nomes é mudança estrutural: para as mesmas entradas, comportamento observável deve permanecer igual.","Nomes claros reduzem esforço para entender legado e a