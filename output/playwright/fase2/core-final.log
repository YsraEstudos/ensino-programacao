ogador: 'Zoe', valida: true, pontos: 9},\n    {id: 'middle', jogador: 'Ana', valida: true, pontos: 5},\n    {id: 'low', jogador: 'Bia', valida: true, pontos: 1},\n  ])).toEqual(['top', 'middle', 'low']);\n});\n"},"reference":[{"path":"main.js","content":"export function ranking(partidas) {\n  return partidas\n    .filter(partida => partida.valida)\n    .map(partida => ({id: partida.id, jogador: partida.jogador, pontos: partida.pontos}))\n    .sort((a, b) => b.pontos - a.pontos || a.jogador.localeCompare(b.jogador))\n    .map(partida => partida.id);\n}\n\nconsole.log(JSON.stringify(ranking([\n  {id: \"a\", jogador: \"Ana\", valida: true, pontos: 8},\n  {id: \"b\", jogador: \"Bia\", valida: true, pontos: 5},\n])));\n"}]},{"item":{"id":"07.06","title":"Reduce ilegível","stage":"07","kind":"MODIFY","contentVersion":2,"optional":false,"duration":"20 min","runtime":"Node.js 24 LTS · ECMAScript 2026 · módulos ES","compatibility":"Node.js 24 LTS como base; use APIs padrão, preserve o contrato de saída e aplique o fallback descrito quando o suporte à API moderna não estiver garantido.","objective":"Registre a saída atual para categoria repetida e o estado do acumulador antes de refatorar.","prompt":"Reproduza a saída do reduce antes de refatorar. Reescreva em passos legíveis e compare os resultados nos mesmos dados; o objetivo é melhorar a leitura sem alterar o comportamento.","firstResponse":{"action":"Registre a saída atual para categoria repetida e o estado do acumulador antes de refatorar.","timing":"Primeiros 2 min de 20 min; registre este raciocínio antes de editar ou executar."},"explanation":{"mental_model":"Uma redução atualiza um resultado à medida que percorre itens. Uma refatoração legível nomeia as decisões importantes e mantém o mesmo comportamento observável.","worked_example":"Em outra refatoração, uma cadeia de ternários que escolhe o rótulo de um pedido pode virar uma função com um caso nomeado por estado. Compare alguns estados antes e depois; a leitura fica mais simples sem alterar a interface nem os rótulos apresentados.","common_trap":"Uma expressão compacta pode esconder agrupamento, inicialização e comportamento de chaves especiais. Prefira um loop claro quando ele tornar essas regras auditáveis.","why_it_matters":"Quem revisa precisa conseguir conferir a agregação, inclusive quando zero e chaves incomuns são dados válidos."},"interaction":"Editor com botões Executar e Comparar e saída esperada/recebida em texto; foco por teclado e falhas anunciadas sem depender de cor.","resources":["Starter visível no cartão: main.js: const resumo=itens.reduce((acc,x)=>{acc[x.categoria]=(acc[x.categoria]===undefined?0:acc[x.categoria])+x.preco;return acc},{}) (texto do contrato, sem arquivo asset separado).","Entrada pública disponível para análise: itens com categorias A:2,A:3,B:4."],"starterFiles":[{"path":"main.js","content":"export function resumirPorCategoria(itens) {\n  const resumo = itens.reduce((acumulado, item) => {\n    acumulado[item.categoria] = item.preco;\n    return acumulado;\n  }, {});\n  return resumo;\n}\n\nconsole.log(JSON.stringify(resumirPorCategoria([\n  {categoria: \"A\", preco: 2},\n  {categoria: \"A\", preco: 3},\n  {categoria: \"B\", preco: 4},\n])));\n"}],"assets":[],"examples":[{"given":"itens com categorias A:2,A:3,B:4","expected":"totais A=5,B=4; entrada intacta"}],"checks":[{"fixture":{"given":"itens com categorias A:2,A:3,B:4","expected":"totais A=5,B=4; entrada intacta"},"scoring":"Rode regressões antigas e novos casos; avalie mudança localizada."}],"constraints":[],"rubric":[],"learningMetadata":{"requires":["04.01","05.01","03.10"]},"edgeCases":["preço 0 -> categoria ainda existe com total 0; categorias comuns mantêm totais independentes"],"review":{"prompt":"O que a função de redução precisa devolver em cada chamada do callback?","choices":["O array completo de entrada para reiniciar o percurso.","O próximo acumulador que será entregue à etapa seguinte.","Um efeito colateral, pois o valor retornado pelo callback é ignorado."],"answer":1,"correctFeedback":"Cada retorno atualiza o acumulador; a etapa seguinte recebe esse valor.","incorrectFeedback":"O retorno do callback não é descartado: ele define o estado acumulado para o próximo passo."},"assessmentEnvironment":"javascript","autoTested":true,"preparation":{"guided":true,"stageTitle":"CALLBACKS E COLEÇÕES","introduction":"Registre a saída atual para categoria repetida e o estado do acumulador antes de refatorar.","explanation":"Uma redução atualiza um resultado à medida que percorre itens. Uma refatoração legível nomeia as decisões importantes e mantém o mesmo comportamento observável.","conceptSteps":["Uma redução atualiza um resultado à medida que percorre itens.","Uma refatoração legível nomeia as decisões importantes e mantém o mesmo comportamento observável.","Quem revisa precisa conseguir conferir a agregação, inclusive quando zero e chaves incomuns são dados válidos."],"vocabulary":[],"workedExample":{"steps":["Em outra refatoração, uma cadeia de ternários que escolhe o rótulo de um pedido pode virar uma função com um caso nomeado por estado.","Compare alguns estados antes e depois; a leitura fica mais simples sem alterar a interface nem os rótulos apresentados."]},"notes":["Uma expressão compacta pode esconder agrupamento, inicialização e comportamento de chaves especiais. Prefira um loop claro quando ele tornar essas regras auditáveis.","Quem revisa precisa conseguir conferir a agregação, inclusive quando zero e chaves incomuns são dados válidos."],"docs":[],"materials":["Starter visível no cartão: main.js: const resumo=itens.reduce((acc,x)=>{acc[x.categoria]=(acc[x.categoria]===undefined?0:acc[x.categoria])+x.preco;return acc},{}) (texto do contrato, sem arquivo asset separado).","Entrada pública disponível para análise: itens com categorias A:2,A:3,B:4."],"predictionGuide":"Registre a saída atual para categoria repetida e o estado do acumulador antes de refatorar. Primeiros 2 min de 20 mi